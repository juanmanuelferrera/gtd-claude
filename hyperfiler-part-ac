        function importTasksFromTextarea() {
            try {
                const textarea = document.getElementById('taskImportTextarea');
                if (!textarea) {
                    console.error('Task import textarea not found');
                    return;
                }
                
                const text = textarea.value.trim();
                if (!text) {
                    alert('Please enter some tasks to import.');
                    return;
                }
                
                // Split by lines and filter out empty lines
                const lines = text.split('\n').filter(line => line.trim());
                
                if (lines.length === 0) {
                    alert('No valid tasks found to import.');
                    return;
                }
                
                // Import each line as a task
                let importedCount = 0;
                const today = new Date();
                const todayStr = getLocalDateString(today);
                
                lines.forEach(line => {
                    const taskTitle = line.trim();
                    if (taskTitle) {
                        // Create new task using the correct task structure
                        const newTask = {
                            id: Date.now() + Math.random(),
                            title: taskTitle,
                            dueDate: todayStr,
                            dueTime: null,
                            completed: false,
                            status: 'pending',
                            priority: 'medium',
                            category: 'personal',
                            tags: [],
                            isEvent: false,
                            description: '',
                            createdAt: new Date().toISOString(),
                            updatedAt: new Date().toISOString()
                        };
                        
                        // Add to the MAIN tasks array (not getTasks())
                        tasks.push(newTask);
                        
                        importedCount++;
                    }
                });
                
                // Save to localStorage and sync
                saveTasksToLocalStorage();
                
                // Immediate UI update (optimistic)
                renderCurrentView();
                
                // Background sync (non-blocking)
                setTimeout(async () => {
                    try {
                        window.justModifiedTasks = true;
                        await uploadAllTasks();
                        setTimeout(() => { window.justModifiedTasks = false; }, 5000);
                        console.log('✅ Import sync completed');
                    } catch (syncError) {
                        console.error('❌ Import sync failed:', syncError);
                    }
                }, 100);
                
                // Clear textarea and close modal
                textarea.value = '';
                closeTaskImportModal();
                
                // Show success message with optimistic feedback
                showOptimisticFeedback(`✅ Imported ${importedCount} tasks`, 'success');
                
            } catch (error) {
                console.error('Error importing tasks:', error);
                alert('Error importing tasks. Please try again.');
            }
        }

