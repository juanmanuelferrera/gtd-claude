        function toggleCheckboxInNotes(checkbox) {
            // Find the parent task element to get the task ID
            const taskElement = checkbox.closest('[data-task-id]');
            if (!taskElement) return;
            
            const taskId = taskElement.getAttribute('data-task-id');
            const task = tasks.find(t => t.id === taskId);
            if (!task || !task.notes) return;
            
            // Find the checkbox item in the original notes text
            const label = checkbox.nextElementSibling;
            const labelText = label.textContent.trim();
            
            // Update the notes text
            let updatedNotes = task.notes;
            
            if (checkbox.checked) {
                // Mark as checked: - [ ] -> - [x]
                updatedNotes = updatedNotes.replace(
                    new RegExp(`^(\\s*)- \\[ \\]\\s*${escapeRegExp(labelText)}$`, 'm'),
                    `$1- [x] ${labelText}`
                );
                // Update visual state
                label.style.textDecoration = 'line-through';
                label.style.opacity = '0.7';
            } else {
                // Mark as unchecked: - [x] -> - [ ]
                updatedNotes = updatedNotes.replace(
                    new RegExp(`^(\\s*)- \\[x\\]\\s*${escapeRegExp(labelText)}$`, 'm'),
                    `$1- [ ] ${labelText}`
                );
                // Update visual state
                label.style.textDecoration = 'none';
                label.style.opacity = '1';
            }
            
            // Update the task and save
            task.notes = updatedNotes;
            saveTask(task).then(() => {
                console.log('✅ Checkbox state saved');
            }).catch(error => {
                console.error('❌ Error saving checkbox state:', error);
                // Revert checkbox state on error
                checkbox.checked = !checkbox.checked;
            });
        }

        function escapeRegExp(string) {
