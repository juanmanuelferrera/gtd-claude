        // FILE SYSTEM BACKUP SYSTEM - NO localStorage
        function createEmergencyBackup() {
            // Prevent creating backups too frequently (minimum 3 minutes between manual backups)
            const lastQuickBackup = localStorage.getItem('gtd_last_quick_backup');
            const lastBackupTime = lastQuickBackup ? parseInt(lastQuickBackup) : 0;
            const timeSinceLastBackup = Date.now() - lastBackupTime;
            const minInterval = 3 * 60 * 1000; // 3 minutes
            
            if (timeSinceLastBackup < minInterval) {
                const remainingTime = Math.ceil((minInterval - timeSinceLastBackup) / 1000 / 60);
                showInlineNotification(`⏰ Please wait ${remainingTime} more minute(s) before creating another quick backup`, 'warning');
                return;
            }
            
            // Create backup data in exact same format as automatic backups
            const backupData = {
                tasks: tasks || [],
                listSections: typeof listSections !== 'undefined' ? listSections : [],
                templates: customTemplates || [],
                trash: typeof trash !== 'undefined' ? trash : [],
                exportDate: new Date().toISOString(),
                totalTasks: tasks ? tasks.length : 0,
                totalListSections: typeof listSections !== 'undefined' ? listSections.length : 0,
                totalTrashItems: typeof trash !== 'undefined' ? trash.length : 0,
                backupReason: "quick-backup",
                forceCloudOverwrite: true // Special flag to ensure backup restore always overwrites cloud data
            };
            
            console.log('📦 Quick backup data size:', JSON.stringify(backupData).length, 'characters');
            
            // Create filename with timestamp
            const timestamp = new Date().toISOString().replace(/[:.]/g, '-').split('T');
            const dateStr = timestamp[0];
            const timeStr = timestamp[1].split('.')[0];
            const filename = `quick-backup-${dateStr}T${timeStr}.json`;
            
            // Download backup file immediately
            const dataStr = JSON.stringify(backupData, null, 2);
            const dataBlob = new Blob([dataStr], {type: 'application/json'});
            const downloadLink = document.createElement('a');
            downloadLink.href = URL.createObjectURL(dataBlob);
            downloadLink.download = filename;
            downloadLink.click();
            
            // Update last backup time
            localStorage.setItem('gtd_last_quick_backup', Date.now().toString());
            
            console.log('💾 Quick backup file downloaded:', filename);
            
            // Show success message
            showInlineNotification('✅ ' + translateText('Quick backup downloaded successfully!') + ` 📁 ${translateText('Check Downloads folder for')} ${filename}`, 'success');
            
            return backupData;
        }

