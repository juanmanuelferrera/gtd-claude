        async function deleteSelectedTasks() {
            // Preserve selected tasks before any operations that might clear them
            window.bulkDeleteSelectedTasks = new Set([...selectedTasks]);
            console.log('🎯 Preserved selected tasks for deletion:', Array.from(window.bulkDeleteSelectedTasks));
            
            // Use preserved tasks if current selection is empty, fallback to current selection
            const tasksToDeleteFrom = selectedTasks.size > 0 ? selectedTasks : (window.bulkDeleteSelectedTasks || new Set());
            
            if (tasksToDeleteFrom.size === 0) {
                alert('❌ No tasks selected for deletion.');
                return;
            }
            
            // Delete operation initiated
            
            const confirmed = confirm(`Are you sure you want to delete ${tasksToDeleteFrom.size} selected task(s)?`);
            if (!confirmed) {
                // Clean up preserved tasks if user cancels
                window.bulkDeleteSelectedTasks = null;
                return;
            }
            
            try {
                // Convert selected task IDs to strings/numbers consistently
                const selectedTaskIds = Array.from(tasksToDeleteFrom).map(id => 
                    typeof id === 'string' ? id : String(id)
                );
                
                // Task IDs normalized
                
                // Collect tasks to delete for trash
                const tasksToDelete = [];
                for (const taskId of selectedTaskIds) {
                    const task = tasks.find(t => String(t.id) === String(taskId));
                    if (task) {
                        console.log('🗑️ DEBUG: Found task to delete:', task.title, 'ID:', task.id);
                        tasksToDelete.push({...task}); // Create copy for trash
                    } else {
                        console.warn('🗑️ WARNING: Task not found for ID:', taskId);
                    }
                }
                
                console.log('🗑️ DEBUG: Tasks to delete:', tasksToDelete.length);
                
                if (tasksToDelete.length === 0) {
                    alert('❌ No valid tasks found to delete.');
                    return;
                }
                
                // Remove tasks from array using filter (safer than splice in loop)
                const originalTasksLength = tasks.length;
                tasks = tasks.filter(task => {
                    const shouldKeep = !selectedTaskIds.includes(String(task.id));
                    if (!shouldKeep) {
                        console.log('🗑️ DEBUG: Removing task:', task.title, 'ID:', task.id);
                    }
                    return shouldKeep;
                });
                
                const deletedCount = originalTasksLength - tasks.length;
                console.log('🗑️ DEBUG: Deleted', deletedCount, 'tasks from array');
                
                // Save to localStorage and sync with workers
                saveTasksToLocalStorage();
                window.justModifiedTasks = true;
                console.log('🔄 BULK DELETE: Calling uploadAllTasks for', deletedCount, 'deleted tasks');
                console.log('🔄 BULK DELETE: Current user auth state:', !!window.currentUser, 'User ID:', window.currentUser?.user?.id);
                await uploadAllTasks();
                setTimeout(() => { window.justModifiedTasks = false; }, 5000);
                
                // Move to trash if any tasks were deleted
                if (tasksToDelete.length > 0) {
                    moveToTrash(tasksToDelete);
                    console.log('🗑️ DEBUG: Moved', tasksToDelete.length, 'tasks to trash');
                }
                
                // Clear selection and update UI
                selectedTasks.clear();
                window.bulkDeleteSelectedTasks = null; // Clean up preserved tasks
                updateSelectionUI();
                
                // Refresh the view
                performAllTasksSearch();
                
                console.log('✅ Successfully deleted', deletedCount, 'task(s)');
                
            } catch (error) {
                console.error('❌ Error deleting selected tasks:', error);
                alert('❌ Error deleting some tasks. Please try again.');
                // Clean up preserved tasks on error
                window.bulkDeleteSelectedTasks = null;
            }
        }

        function delaySelectedTasks(days) {
            // Preserve selected tasks before any operations that might clear them
            window.bulkDelaySelectedTasks = new Set([...selectedTasks]);
            console.log('🎯 Preserved selected tasks for delay:', Array.from(window.bulkDelaySelectedTasks));
            
            // Use preserved tasks if current selection is empty, fallback to current selection
            const tasksToDelayFrom = selectedTasks.size > 0 ? selectedTasks : (window.bulkDelaySelectedTasks || new Set());
            
            if (tasksToDelayFrom.size === 0) {
                console.log('🔍 DEBUG: No tasks selected for delay');
                return;
            }
            
            console.log('📅 OPTIMISTIC: Delaying', tasksToDelayFrom.size, 'selected tasks by', days, 'days');
            
            // Store original state for potential rollback
            const originalTasks = [];
            const affectedTaskIds = Array.from(tasksToDelayFrom);
            
            try {
                let delayedCount = 0;
                const delayLabel = days === 1 ? '+1D' : days === 7 ? '+1W' : days === 30 ? '+1M' : `+${days}D`;
                
                // Backup original tasks for rollback
                for (const taskId of tasksToDelayFrom) {
                    const task = tasks.find(t => String(t.id) === String(taskId));
                    if (task) {
                        originalTasks.push({
                            id: task.id,
                            dueDate: task.dueDate
                        });
                    }
                }
                
                // Process each selected task (OPTIMISTIC UPDATE)
                for (const taskId of tasksToDelayFrom) {
                    const task = tasks.find(t => String(t.id) === String(taskId));
                    if (task) {
                        // Calculate new date
                        const currentDate = task.dueDate ? new Date(task.dueDate + 'T00:00:00') : new Date();
                        currentDate.setDate(currentDate.getDate() + days);
                        const newDateStr = getLocalDateString(currentDate);
                        
                        // Update task optimistically
                        task.dueDate = newDateStr;
                        task.updatedAt = new Date().toISOString();
                        delayedCount++;
                        
                        console.log('📅 OPTIMISTIC: Delayed task', taskId, 'to', newDateStr);
                    }
                }
                
                // Immediate UI update (optimistic feedback)
                selectedTasks.clear();
                window.bulkDelaySelectedTasks = null; // Clean up preserved tasks
                updateSelectionUI();
                renderCurrentView();
                
                // Show optimistic success message
                showOptimisticFeedback(`⚡ ${delayLabel}: ${delayedCount} task(s) rescheduled`, 'success');
                console.log('✅ OPTIMISTIC: UI updated immediately - delayed', delayedCount, 'task(s) by', days, 'days');
                
                // Background sync (non-blocking)
                setTimeout(async () => {
                    try {
                        saveTasksToLocalStorage();
                        window.justModifiedTasks = true;
                        const syncSuccess = await uploadAllTasks();
                        setTimeout(() => { window.justModifiedTasks = false; }, 5000);
                        
                        if (syncSuccess) {
                            console.log('✅ SYNC SUCCESS: Background sync completed for', delayedCount, 'delayed task(s)');
                            showOptimisticFeedback(`✅ ${delayLabel}: Changes synced`, 'success', 2000);
                        } else {
                            throw new Error('Upload failed');
                        }
                    } catch (syncError) {
                        console.error('❌ SYNC FAILED: Background sync failed:', syncError);
                        
                        // ROLLBACK: Restore original dates
                        originalTasks.forEach(orig => {
                            const task = tasks.find(t => t.id === orig.id);
                            if (task) {
                                task.dueDate = orig.dueDate;
                            }
                        });
                        
                        // Update UI to reflect rollback
                        renderCurrentView();
                        saveTasksToLocalStorage();
                        
                        showOptimisticFeedback(`❌ ${delayLabel}: Sync failed, changes reverted`, 'error', 4000);
                        console.log('🔄 ROLLBACK: Restored original dates due to sync failure');
                    }
                }, 100); // Small delay to let UI update first
                
            } catch (error) {
                console.error('❌ OPTIMISTIC ERROR: Error delaying selected tasks:', error);
                showOptimisticFeedback('❌ Error rescheduling tasks', 'error');
                
                // Clean up preserved tasks on error
                window.bulkDelaySelectedTasks = null;
                
                // Restore UI if immediate operation failed
                renderCurrentView();
            }
        }

