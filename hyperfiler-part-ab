                    const { _groupTasks, _groupCount, ...cleanTask } = task;
                    return cleanTask;
                });
                
                saveStateForUndo('change repeat type for series');
                
                // Restore original tasks with metadata
                tasks = originalTasks;
                
                if (newType === 'none') {
                    console.log('Processing "Remove" option for repeat series:', taskTitle);
                    console.log('About to delete', seriesTasks.length, 'tasks');
                    console.log('Tasks to delete:', seriesTasks.map(t => ({id: t.id, title: t.title, date: t.dueDate})));
                    
                    // Delete ALL instances of the repeat task
                    for (const task of seriesTasks) {
                        console.log('Deleting task:', task.id, task.title);
                        const actualTask = tasks.find(t => t.id === task.id);
                        if (actualTask) {
                            console.log('Found actual task, removing from tasks array');
                            tasks = tasks.filter(t => t.id !== actualTask.id);
                            console.log('Calling deleteTask function');
                            await deleteTask(actualTask.id);
                            console.log('deleteTask completed for:', actualTask.id);
                        } else {
                            console.log('Warning: actualTask not found for ID:', task.id);
                        }
                    }
                    console.log('All deletions completed');
                    alert(`✅ Successfully deleted all ${seriesTasks.length} instances of the repeat task!`);
                    
                    // Force immediate view refresh (database already saved by deleteTask calls)
                    renderRepeatView();
                    renderCurrentView();
                } else {
                    // Delete old series and create new one with proper frequency
                    const baseTask = seriesTasks[0]; // Use first task as template
                    const startDate = new Date(baseTask.dueDate);
                    
                    // Remove all old tasks in the series
                    for (const task of seriesTasks) {
                        const actualTask = tasks.find(t => t.id === task.id);
                        if (actualTask) {
                            tasks = tasks.filter(t => t.id !== actualTask.id);
                            await deleteTask(actualTask.id);
                        }
                    }
                    
                    // Create new series with correct frequency
                    const baseId = Date.now();
                    let iterations, incrementDays;
                    
                    switch (newType) {
                        case 'daily':
                            iterations = 90;
                            incrementDays = 1;
                            break;
                        case 'weekly-3months':
                            iterations = 12;
                            incrementDays = 7;
                            break;
                        case 'biweekly-6months':
                            iterations = 12;
                            incrementDays = 14;
                            break;
                        case 'monthly':
                            iterations = 12;
                            incrementDays = 30;
                            break;
                        case 'annual-5years':
                            iterations = 5;
                            incrementDays = 365;
                            break;
                        default:
                            iterations = 1;
                            incrementDays = 0;
                    }
                    
                    // Create new tasks with proper dates
                    for (let i = 0; i < iterations; i++) {
                        const currentDate = new Date(startDate);
                        currentDate.setDate(currentDate.getDate() + (i * incrementDays));
                        
                        const newTask = {
                            id: baseId + i,
                            title: baseTask.title,
                            notes: baseTask.notes || '',
                            images: [],
                            dueDate: currentDate.toISOString().split('T')[0],
                            dueTime: baseTask.dueTime || '',
                            priority: baseTask.priority || 'medium',
                            status: 'pending',
                            repeat: newType,
                            isEvent: baseTask.isEvent || false,
                            createdAt: new Date().toISOString()
                        };
                        
                        tasks.push(newTask);
                        await saveTask(newTask);
                    }
                    
                    alert(`✅ Successfully created ${iterations} new tasks with ${newDescription}!`);
                }
                
                renderRepeatView();
                renderCurrentView();
                
            } catch (error) {
                console.error('Error in changeRepeatTypeDropdown:', error);
                alert('❌ Error updating repeat type. Check console for details.');
            }
        }

