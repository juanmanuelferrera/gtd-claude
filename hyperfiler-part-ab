        // Undo functionality
        function saveStateForUndo(action, task = null) {
            try {
                // Create clean copies without circular references
                const cleanTasks = tasks.map(t => ({
                    id: t.id,
                    title: t.title,
                    dueDate: t.dueDate,
                    dueTime: t.dueTime,
                    notes: t.notes,
                    isEvent: t.isEvent,
                    status: t.status,
                    createdAt: t.createdAt,
                    repeat: t.repeat
                }));
                
                const cleanTask = task ? {
                    id: task.id,
                    title: task.title,
                    dueDate: task.dueDate,
                    dueTime: task.dueTime,
                    notes: task.notes,
                    isEvent: task.isEvent,
                    status: task.status,
                    createdAt: task.createdAt,
                    repeat: task.repeat
                } : null;
                
                const state = {
                    action: action,
                    tasks: cleanTasks,
                    task: cleanTask,
                    timestamp: Date.now()
                };
            
                console.log('🎯 saveStateForUndo - Action:', action, 'Task count:', cleanTasks.length);
                undoStack.push(state);
                console.log('🎯 saveStateForUndo - Stack length after push:', undoStack.length);
                
                // Limit undo stack size
                if (undoStack.length > maxUndoSteps) {
                    undoStack.shift();
                    console.log('🎯 saveStateForUndo - Stack trimmed to max size:', maxUndoSteps);
                }
            } catch (error) {
                console.error('Error saving state for undo:', error);
                // Don't block the main operation if undo save fails
            }
        }

        async function performUndo() {
            console.log('🎯 performUndo called, undo stack length:', undoStack.length);
            if (undoStack.length === 0) {
                console.log('❌ No undo actions available');
                alert('Nothing to undo');
                return;
            }

            const lastState = undoStack.pop();
            console.log('🎯 Restoring state:', lastState.action);
            
            try {
                // Restore tasks from the saved state
                if (lastState && lastState.tasks) {
                    tasks = JSON.parse(JSON.stringify(lastState.tasks));
                    console.log('✅ Tasks restored from undo state, count:', tasks.length);
                    
                    // Save to localStorage
                    try {
                        saveTasksToLocalStorage();
                        console.log('✅ Saved to localStorage');
                    } catch (localError) {
                        console.error('❌ Error saving to localStorage:', localError);
                    }
                    
                    // Try to upload to cloud if available
                    try {
                        if (typeof uploadAllTasks === 'function') {
                            window.justModifiedTasks = true;
                            await uploadAllTasks();
                            setTimeout(() => { window.justModifiedTasks = false; }, 5000);
                            console.log('✅ Mobile Sync: Undo uploaded to cloud');
                        }
                    } catch (uploadError) {
                        console.warn('⚠️ Upload error during undo, continuing with local storage:', uploadError);
                    }
                    
                    // Re-render everything
                    try {
                        sortTasks();
                        renderCurrentView();
                        console.log('✅ Views re-rendered');
                    } catch (renderError) {
                        console.error('❌ Error rendering views:', renderError);
                    }
                    
                    // Show feedback
                    const actionText = lastState.action || 'last action';
                    showUndoNotification(`✅ Undid: ${actionText}`);
                    console.log('✅ Undo completed successfully');
                    
                } else {
                    console.error('❌ Invalid undo state:', lastState);
                    alert('❌ Invalid undo state');
                }
                
            } catch (error) {
                console.error('❌ Error performing undo:', error);
                alert('❌ Error performing undo. Please try again.');
                
                // Restore the popped state since undo failed
                undoStack.push(lastState);
            }
        }

