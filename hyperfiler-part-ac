        // Get suggested times based on current task time
        function getSuggestedTimes(currentTime) {
            const now = new Date();
            const currentHour = now.getHours();
            
            let baseTimes = [];
            let startHour;
            
            if (currentTime) {
                // If task has time, dynamically add 3 hours until 22:00 (same day only)
                const [hour, minute] = currentTime.split(':').map(Number);
                let nextHour = hour + 3; // Start 3 hours after current time
                
                // Keep adding 3-hour intervals until we reach or exceed 22:00 (no next day)
                while (nextHour <= 22 && baseTimes.length < 9) {
                    baseTimes.push(`${String(nextHour).padStart(2, '0')}:00`);
                    nextHour += 3;
                }
                
                // Always include 22:00 if not already included and we have space
                if (!baseTimes.includes('22:00') && baseTimes.length < 9) {
                    baseTimes.push('22:00');
                }
                
                // Fill remaining slots with useful times (only current day, max 22:00)
                while (baseTimes.length < 9) {
                    const fillerTimes = ['09:00', '12:00', '15:00', '18:00', '21:00', '20:00', '19:00', '17:00', '14:00', '11:00', '13:00', '16:00'];
                    for (const time of fillerTimes) {
                        const [fillerHour] = time.split(':').map(Number);
                        // Only add times that are within the same day (≤ 22:00)
                        if (fillerHour <= 22 && !baseTimes.includes(time) && baseTimes.length < 9) {
                            baseTimes.push(time);
                        }
                    }
                    break;
                }
            } else {
                // If no time, start from current hour and add 3-hour intervals (same day only)
                let nextHour = currentHour;
                
                while (nextHour <= 22 && baseTimes.length < 9) {
                    baseTimes.push(`${String(nextHour).padStart(2, '0')}:00`);
                    nextHour += 3;
                }
                
                // Fill remaining slots if needed (only current day times)
                while (baseTimes.length < 9) {
                    const fillerTimes = ['09:00', '12:00', '15:00', '18:00', '21:00', '22:00', '20:00', '19:00', '17:00'];
                    for (const time of fillerTimes) {
                        const [fillerHour] = time.split(':').map(Number);
                        // Only add times that are within the same day (≤ 22:00)
                        if (fillerHour <= 22 && !baseTimes.includes(time) && baseTimes.length < 9) {
                            baseTimes.push(time);
                        }
                    }
                    break;
                }
            }
            
            return baseTimes.slice(0, 9); // Always return exactly 9 slots
        }

