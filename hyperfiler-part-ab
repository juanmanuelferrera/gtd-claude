        // Save task using simple pattern like Lists: update array → saveTasksToServer
        async function saveTask(taskData) {
            try {
                
                // SECURITY: Validate input before saving
                if (!taskData || typeof taskData !== 'object') {
                    console.error('Invalid task data:', taskData);
                    return null;
                }
                
                const validatedTitle = validateTaskTitle(taskData.title);
                const validatedNotes = validateTaskNotes(taskData.notes);
                
