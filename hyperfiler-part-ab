        async function moveListToSection(sourceSectionId, listId) {
            const sourceSection = listSections.find(s => s.id === sourceSectionId);
            if (!sourceSection) return;
            
            const list = sourceSection.lists.find(l => l.id === listId);
            if (!list) return;
            
            // Get available sections (excluding current section)
            const availableSections = listSections.filter(s => s.id !== sourceSectionId);
            
            if (availableSections.length === 0) {
                alert('No other sections available to move this list to.');
                return;
            }
            
            // Create options for selection
            let options = 'Select destination section:\n\n';
            availableSections.forEach((section, index) => {
                options += `${index + 1}. ${section.name}\n`;
            });
            
            const choice = prompt(options + '\nEnter the number of the destination section:');
            if (!choice) return; // User cancelled
            
            const choiceIndex = parseInt(choice) - 1;
            if (choiceIndex < 0 || choiceIndex >= availableSections.length) {
                alert('Invalid selection. Please try again.');
                return;
            }
            
            const targetSection = availableSections[choiceIndex];
            
            // Confirm the move
            if (!confirm(`Move "${list.name}" from "${sourceSection.name}" to "${targetSection.name}"?`)) {
                return;
            }
            
            // Remove from source section
            sourceSection.lists = sourceSection.lists.filter(l => l.id !== listId);
            
            // Add to target section
            if (!targetSection.lists) {
                targetSection.lists = [];
            }
            targetSection.lists.push(list);
            
            // Save changes
            await saveListSections();
            
            // Refresh view
            renderListsView();
            
            alert(`✅ List "${list.name}" moved to section "${targetSection.name}".`);
        }

        async function mergeListWithAnother(sourceSectionId, sourceListId) {
            const sourceSection = listSections.find(s => s.id === sourceSectionId);
            if (!sourceSection) return;
            
            const sourceList = sourceSection.lists.find(l => l.id === sourceListId);
            if (!sourceList) return;
            
            // Get all lists except the source list
            const availableLists = [];
            listSections.forEach(section => {
                if (section.lists) {
                    section.lists.forEach(list => {
                        if (!(section.id === sourceSectionId && list.id === sourceListId)) {
                            availableLists.push({
                                sectionId: section.id,
                                sectionName: section.name,
                                listId: list.id,
                                listName: list.name,
                                itemCount: list.items ? list.items.length : 0
                            });
                        }
                    });
                }
            });
            
            if (availableLists.length === 0) {
                alert('No other lists available to merge with.');
                return;
            }
            
            // Create options for selection
            let options = `Merge "${sourceList.name}" with:\n\n`;
            availableLists.forEach((listInfo, index) => {
                options += `${index + 1}. ${listInfo.listName} (${listInfo.sectionName}) - ${listInfo.itemCount} items\n`;
            });
            
            const choice = prompt(options + '\nEnter the number of the target list:');
            if (!choice) return; // User cancelled
            
            const choiceIndex = parseInt(choice) - 1;
            if (choiceIndex < 0 || choiceIndex >= availableLists.length) {
                alert('Invalid selection. Please try again.');
                return;
            }
            
            const targetListInfo = availableLists[choiceIndex];
            const targetSection = listSections.find(s => s.id === targetListInfo.sectionId);
            const targetList = targetSection.lists.find(l => l.id === targetListInfo.listId);
            
            const sourceItemCount = sourceList.items ? sourceList.items.length : 0;
            const targetItemCount = targetList.items ? targetList.items.length : 0;
            
            // Confirm the merge
            if (!confirm(`Merge "${sourceList.name}" (${sourceItemCount} items) into "${targetList.name}" (${targetItemCount} items)?\n\nThe source list will be deleted after merging.`)) {
                return;
            }
            
            // Initialize target list items if needed
            if (!targetList.items) {
                targetList.items = [];
            }
            
            // Merge items, avoiding duplicates
            let mergedCount = 0;
            if (sourceList.items) {
                sourceList.items.forEach(sourceItem => {
                    // Check if item already exists (by text)
                    const exists = targetList.items.some(targetItem => targetItem.text === sourceItem.text);
                    if (!exists) {
                        targetList.items.push({
                            id: Date.now() + Math.random(),
                            text: sourceItem.text,
                            completed: sourceItem.completed || false
                        });
                        mergedCount++;
                    }
                });
            }
            
            // Remove source list
            sourceSection.lists = sourceSection.lists.filter(l => l.id !== sourceListId);
            
            // Save changes
            await saveListSections();
            renderListsView();
            
            alert(`✅ Merge complete!\n\n${mergedCount} items merged from "${sourceList.name}" to "${targetList.name}".\nSource list has been deleted.`);
        }

        async function duplicateList(sectionId, listId) {
            const section = listSections.find(s => s.id === sectionId);
            if (!section) return;
            
            const originalList = section.lists.find(l => l.id === listId);
            if (!originalList) return;
            
            // Ask for the new list name
            const newName = prompt(`Duplicate "${originalList.name}" as:`, `${originalList.name} - Copy`);
            if (!newName || newName.trim() === '') return;
            
            // Check if name already exists in the section
            const nameExists = section.lists.some(list => list.name === newName.trim());
            if (nameExists) {
                alert(`A list named "${newName.trim()}" already exists in this section.`);
                return;
            }
            
            // Create duplicate list with guaranteed unique integer IDs
            const baseTimestamp = Date.now();
            const randomSuffix = Math.floor(Math.random() * 9999) + 1; // 1-9999
            const duplicatedList = {
                id: parseInt(baseTimestamp + '' + randomSuffix.toString().padStart(4, '0')),
                name: newName.trim(),
                items: originalList.items ? originalList.items.map((item, index) => {
                    const itemRandom = Math.floor(Math.random() * 99) + 1; // 1-99
                    return {
                        id: parseInt(baseTimestamp + '' + (index + 1).toString().padStart(2, '0') + itemRandom.toString().padStart(2, '0')),
                        text: item.text,
                        completed: false // Reset completion status for new copy
                    };
                }) : []
            };
            
            // Add to the same section
            if (!section.lists) {
                section.lists = [];
            }
            section.lists.push(duplicatedList);
            
            // Save changes
            await saveListSections();
            
            // Force a complete refresh after a small delay
            setTimeout(() => {
                renderListsView();
            }, 100);
            
            const itemCount = duplicatedList.items.length;
            alert(`✅ List duplicated successfully!\n\n"${originalList.name}" copied as "${newName.trim()}" with ${itemCount} items.\nAll items are unmarked in the copy.`);
        }
        
