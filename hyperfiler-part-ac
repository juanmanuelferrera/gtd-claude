        function checkDailyBackup() {
            const settings = getBackupSettings();
            if (!settings.enabled || !settings.daily) return;
            
            const now = new Date();
            const lastDaily = backupSettings.lastDailyBackup ? new Date(backupSettings.lastDailyBackup) : null;
            
            // Don't backup if we already backed up in the last 20 hours (prevent duplicates)
            if (lastDaily && (now - lastDaily) < 20 * 60 * 60 * 1000) {
                console.log('⏰ Daily backup skipped - already backed up recently');
                return;
            }
            
            // Check if it's 2 AM (within a 2-hour window) or if we never backed up
            const currentHour = now.getHours();
            const isBackupTime = currentHour >= 2 && currentHour < 4; // Expanded window
            
            // Only backup if it's backup time OR we've never backed up OR it's been more than 24 hours
            const shouldBackup = !lastDaily || 
                (isBackupTime && now.toDateString() !== lastDaily.toDateString()) ||
                (now - lastDaily) >= 24 * 60 * 60 * 1000;
            
            if (shouldBackup) {
                console.log('💾 Creating daily backup - Last backup:', lastDaily ? lastDaily.toISOString() : 'never');
                createAutomaticBackup('daily');
                storeAutomaticBackup('daily'); // Also store for restoration
                backupSettings.lastDailyBackup = now.toISOString();
                saveBackupSettings();
                
