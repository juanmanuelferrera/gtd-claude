        // Touch swipe variables
        let touchStartX = 0;
        let touchStartY = 0;
        let currentSwipeElement = null;
        let isSwipeInProgress = false;
        let swipeStartTime = 0;
        
        function handleTaskTouchStart(event) {
            if (event.touches.length !== 1) return;
            
            touchStartX = event.touches[0].clientX;
            touchStartY = event.touches[0].clientY;
            currentSwipeElement = event.currentTarget;
            isSwipeInProgress = false;
            swipeStartTime = Date.now();
        }
        
        function handleTaskTouchMove(event) {
            if (!currentSwipeElement || event.touches.length !== 1) return;
            
            const touchX = event.touches[0].clientX;
            const touchY = event.touches[0].clientY;
            const deltaX = touchX - touchStartX;
            const deltaY = touchY - touchStartY;
            
            // Check if it's primarily horizontal swipe
            if (Math.abs(deltaX) > Math.abs(deltaY) && Math.abs(deltaX) > 15) {
                if (!isSwipeInProgress) {
                    isSwipeInProgress = true;
                    event.preventDefault();
                }
                
                // Prevent scrolling during horizontal swipe
                if (isSwipeInProgress) {
                    event.preventDefault();
                    
                    // Limit transform to reasonable range
                    const limitedDeltaX = Math.max(-120, Math.min(120, deltaX));
                    currentSwipeElement.style.transform = `translateX(${limitedDeltaX * 0.4}px)`;
                    currentSwipeElement.style.transition = 'none';
                    
                    // Show action hint
                    if (deltaX > 30) {
                        currentSwipeElement.style.background = 'rgba(255, 193, 7, 0.15)';
                    } else if (deltaX < -30) {
                        currentSwipeElement.style.background = 'rgba(220, 53, 69, 0.15)';
                    } else {
                        currentSwipeElement.style.background = '';
                    }
                }
            }
        }
        
        function handleTaskTouchEnd(event) {
            if (!currentSwipeElement) return;
            
            const touchX = event.changedTouches[0].clientX;
            const deltaX = touchX - touchStartX;
            const taskId = currentSwipeElement.dataset.taskId;
            const swipeTime = Date.now() - swipeStartTime;
            
            // Reset styles with smooth transition
            currentSwipeElement.style.transition = 'transform 0.3s ease, background 0.3s ease';
            currentSwipeElement.style.transform = '';
            currentSwipeElement.style.background = '';
            
            // Only trigger if it was a real swipe (not just a tap)
            if (isSwipeInProgress && Math.abs(deltaX) > 60 && swipeTime < 1000) {
                setTimeout(() => {
                    if (deltaX > 0) {
                        // Swipe right - open delay modal
                        toggleMobileTimeDropdown(taskId, event);
                    } else {
                        // Swipe left - delete task
                        quickDeleteTask(taskId, event);
                    }
                }, 100);
            }
            
            // Reset swipe state
            currentSwipeElement = null;
            isSwipeInProgress = false;
            swipeStartTime = 0;
        }

