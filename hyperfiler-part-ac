            console.log('🔄 Dragged task:', draggedTask ? draggedTask.title : 'none');
            
            if (!draggedTask || !timeSlot) {
                console.error('❌ Missing draggedTask or timeSlot:', {draggedTask, timeSlot});
                return;
            }
            
            // Use the draggedTask object directly
            const task = draggedTask;
            
            // Update task time
            const oldTime = task.dueTime;
            if (timeSlot === 'no-time') {
                task.dueTime = null; // Remove time
