        // Export all data as human-readable text file
        function exportTasksAsText() {
            // Confirmation dialog
            const confirmed = confirm("Are you sure to download all your data to a text file?\n\nThis will create a readable text file with all your tasks, events, templates, and lists.");
            if (!confirmed) return;
            
            try {
                const now = new Date();
                const timestamp = now.toLocaleString();
                
                let textContent = `# HyperFiler Pro - All Data Export\n`;
                textContent += `Export Date: ${timestamp}\n`;
                textContent += `Total Tasks: ${tasks.length}\n\n`;
                
                // Group tasks by status
                const pendingTasks = tasks.filter(t => t.status === 'pending');
                const completedTasks = tasks.filter(t => t.status === 'completed');
                const events = tasks.filter(t => t.isEvent);
                
                // Pending Tasks
                if (pendingTasks.length > 0) {
                    textContent += `## PENDING TASKS (${pendingTasks.length})\n`;
                    textContent += `${'='.repeat(50)}\n\n`;
                    
                    pendingTasks.forEach((task, index) => {
                        textContent += `${index + 1}. ${task.title}\n`;
                        if (task.dueDate) textContent += `   Due: ${task.dueDate}${task.dueTime ? ' at ' + task.dueTime : ''}\n`;
                        if (task.notes) textContent += `   Notes: ${task.notes}\n`;
                        if (task.priority && task.priority !== 'medium') textContent += `   Priority: ${task.priority}\n`;
                        textContent += '\n';
                    });
                }
                
                // Events
                if (events.length > 0) {
                    textContent += `## EVENTS (${events.length})\n`;
                    textContent += `${'='.repeat(50)}\n\n`;
                    
                    events.forEach((task, index) => {
                        textContent += `${index + 1}. 🔴 ${task.title}\n`;
                        if (task.dueDate) textContent += `   Date: ${task.dueDate}${task.dueTime ? ' at ' + task.dueTime : ''}\n`;
                        if (task.notes) textContent += `   Notes: ${task.notes}\n`;
                        textContent += '\n';
                    });
                }
                
                // Completed Tasks
                if (completedTasks.length > 0) {
                    textContent += `## COMPLETED TASKS (${completedTasks.length})\n`;
                    textContent += `${'='.repeat(50)}\n\n`;
                    
                    completedTasks.forEach((task, index) => {
                        textContent += `${index + 1}. ✅ ${task.title}\n`;
                        if (task.dueDate) textContent += `   Due: ${task.dueDate}${task.dueTime ? ' at ' + task.dueTime : ''}\n`;
                        if (task.completedAt) textContent += `   Completed: ${new Date(task.completedAt).toLocaleString()}\n`;
                        if (task.notes) textContent += `   Notes: ${task.notes}\n`;
                        textContent += '\n';
                    });
                }
                
                // Templates
                if (customTemplates && customTemplates.length > 0) {
                    textContent += `## TEMPLATES (${customTemplates.length})\n`;
                    textContent += `${'='.repeat(50)}\n\n`;
                    customTemplates.forEach((template, index) => {
                        textContent += `${index + 1}. ${template}\n`;
                    });
                    textContent += '\n';
                }
                
                // Lists (if available)
                if (typeof listSections !== 'undefined' && listSections.length > 0) {
                    textContent += `## LISTS\n`;
                    textContent += `${'='.repeat(50)}\n\n`;
                    
                    listSections.forEach(section => {
                        textContent += `### ${section.name}\n`;
                        if (section.lists && section.lists.length > 0) {
                            section.lists.forEach(list => {
                                textContent += `  - ${list.name} (${list.items ? list.items.length : 0} items)\n`;
                                if (list.items && list.items.length > 0) {
                                    list.items.forEach(item => {
                                        textContent += `    • ${item.text}\n`;
                                    });
                                }
                            });
                        }
                        textContent += '\n';
                    });
                }
                
                // Create and download text file
                const textBlob = new Blob([textContent], {type: 'text/plain'});
                const link = document.createElement('a');
                link.href = URL.createObjectURL(textBlob);
                const filename = `hyperfiler-export-${now.toISOString().slice(0, 10)}.txt`;
                link.download = filename;
                link.click();
                
                alert(`✅ Text export complete!\n\nFile saved: ${filename}\nLocation: Downloads folder\n\nContains: ${tasks.length} tasks, templates, and lists in readable format.`);
                
            } catch (error) {
                console.error('Text export error:', error);
                alert('❌ Error exporting text file.');
            }
        }

        function importTextFile() {
            const input = document.createElement('input');
            input.type = 'file';
            input.accept = '.txt,.text';
            input.style.display = 'none';
            
            input.onchange = function(e) {
                const file = e.target.files[0];
                if (!file) return;
                
                const reader = new FileReader();
                reader.onload = function(event) {
                    try {
                        const content = event.target.result;
                        const lines = content.split('\n').filter(line => line.trim());
                        
                        if (lines.length === 0) {
                            alert(translateText('❌ No valid tasks found in the file'));
                            return;
                        }
                        
                        // Convert each line to a task
                        const importedTasks = lines.map(line => ({
                            id: Date.now() + Math.random(),
                            title: line.trim(),
                            dueDate: '',
                            time: '',
                            priority: 'medium',
                            completed: false,
                            recurring: false,
                            dateAdded: new Date().toISOString()
                        }));
                        
                        // Add to existing tasks
                        tasks.push(...importedTasks);
                        saveTasksToLocalStorage();
                        renderCurrentView();
                        
                        alert(translateText(`✅ Successfully imported ${importedTasks.length} tasks from text file!`));
                        
                    } catch (error) {
                        console.error('Error importing text file:', error);
                        alert(translateText('❌ Error importing text file. Please check the format.'));
                    }
                };
                reader.readAsText(file);
            };
            
            document.body.appendChild(input);
            input.click();
            document.body.removeChild(input);
        }

