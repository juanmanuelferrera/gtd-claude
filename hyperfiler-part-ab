        // Natural language parsing for task input
        function parseNaturalLanguage(input) {
            if (!input || typeof input !== 'string') return null;
            
            const original = input.trim();
            if (!original) return null;
            
            // Helper function to get date string for relative dates
            function getDateForRelative(relative) {
                const today = new Date();
                const tomorrow = new Date(today.getTime() + 24 * 60 * 60 * 1000);
                
                switch (relative.toLowerCase()) {
                    case 'today':
                        return getLocalDateString(today);
                    case 'tomorrow':
                        return getLocalDateString(tomorrow);
                    default:
                        return null;
                }
            }
            
            // Helper function to get date string for weekdays
            function getDateForWeekday(weekday) {
                const today = new Date();
                const dayNames = ['sunday', 'monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday'];
                const targetDay = dayNames.findIndex(day => day === weekday.toLowerCase());
                
                if (targetDay === -1) return null;
                
                const currentDay = today.getDay();
                let daysUntilTarget = targetDay - currentDay;
                
                // If the target day is today or in the past, move to next week
                if (daysUntilTarget <= 0) {
                    daysUntilTarget += 7;
                }
                
                const targetDate = new Date(today.getTime() + daysUntilTarget * 24 * 60 * 60 * 1000);
                return getLocalDateString(targetDate);
            }
            
            // Helper function to get date string for relative periods
            function getDateForRelativePeriod(amount, unit) {
                const today = new Date();
                let num;
                
                // Handle both numbers and "a" (as in "in a month")
                if (amount.toLowerCase() === 'a' || amount.toLowerCase() === 'an') {
                    num = 1;
                } else {
                    num = parseInt(amount);
                }
                
                if (isNaN(num) || num < 1) return null;
                
                let targetDate;
                switch (unit.toLowerCase()) {
                    case 'day':
                    case 'days':
                        targetDate = new Date(today.getTime() + num * 24 * 60 * 60 * 1000);
                        break;
                    case 'week':
                    case 'weeks':
                        targetDate = new Date(today.getTime() + num * 7 * 24 * 60 * 60 * 1000);
                        break;
                    case 'month':
                    case 'months':
                        targetDate = new Date(today);
                        targetDate.setMonth(targetDate.getMonth() + num);
                        break;
                    case 'year':
                    case 'years':
                        targetDate = new Date(today);
                        targetDate.setFullYear(targetDate.getFullYear() + num);
                        break;
                    default:
                        return null;
                }
                
                return getLocalDateString(targetDate);
            }
            
            // Helper function to normalize time format
            function normalizeTime(timeStr) {
                if (!timeStr) return null;
                
                // Handle formats like "6pm", "6:30pm", "18:00", "6:30"
                const pmMatch = timeStr.match(/^(\d{1,2})(?::(\d{2}))?\s*pm$/i);
                const amMatch = timeStr.match(/^(\d{1,2})(?::(\d{2}))?\s*am$/i);
                const is24Hour = timeStr.match(/^(\d{1,2}):(\d{2})$/);
                
                if (pmMatch) {
                    let hour = parseInt(pmMatch[1]);
                    const minute = pmMatch[2] || '00';
                    if (hour !== 12) hour += 12; // Convert PM to 24-hour
                    return `${hour.toString().padStart(2, '0')}:${minute}`;
                } else if (amMatch) {
                    let hour = parseInt(amMatch[1]);
                    const minute = amMatch[2] || '00';
                    if (hour === 12) hour = 0; // Convert 12 AM to 00
                    return `${hour.toString().padStart(2, '0')}:${minute}`;
                } else if (is24Hour) {
                    return timeStr;
                }
                
                return null;
            }
            
            // Patterns for different natural language formats
            const patterns = [
                // Standard order: "task tomorrow at 6pm" or "task today at 6:30"
                {
                    regex: /^(.+?)\s+(today|tomorrow)\s+at\s+(.+)$/i,
                    parser: (match) => ({
                        title: match[1].trim(),
                        date: getDateForRelative(match[2]),
                        time: normalizeTime(match[3])
                    })
                },
                // Reverse order: "tomorrow at 6pm task"
                {
                    regex: /^(today|tomorrow)\s+at\s+(.+?)\s+(.+)$/i,
                    parser: (match) => ({
                        title: match[3].trim(),
                        date: getDateForRelative(match[1]),
                        time: normalizeTime(match[2])
                    })
                },
                // Standard order without "at": "task tomorrow 6pm" or "task today 9:30am"
                {
                    regex: /^(.+?)\s+(today|tomorrow)\s+(.+\S.*)$/i,
                    parser: (match) => {
                        const timeResult = normalizeTime(match[3]);
                        if (timeResult) {
                            return {
                                title: match[1].trim(),
                                date: getDateForRelative(match[2]),
                                time: timeResult
                            };
                        }
                        return null;
                    }
                },
                // Reverse order without "at": "tomorrow 6pm task"
                {
                    regex: /^(today|tomorrow)\s+(.+\S.*)\s+(.+)$/i,
                    parser: (match) => {
                        const timeResult = normalizeTime(match[2]);
                        if (timeResult) {
                            return {
                                title: match[3].trim(),
                                date: getDateForRelative(match[1]),
                                time: timeResult
                            };
                        }
                        return null;
                    }
                },
                // Standard order: "task on monday at 6pm" or "task on friday at 9:30am"
                {
                    regex: /^(.+?)\s+on\s+(monday|tuesday|wednesday|thursday|friday|saturday|sunday)\s+at\s+(.+)$/i,
                    parser: (match) => ({
                        title: match[1].trim(),
                        date: getDateForWeekday(match[2]),
                        time: normalizeTime(match[3])
                    })
                },
                // Reverse order: "on monday at 6pm task"
                {
                    regex: /^on\s+(monday|tuesday|wednesday|thursday|friday|saturday|sunday)\s+at\s+(.+?)\s+(.+)$/i,
                    parser: (match) => ({
                        title: match[3].trim(),
                        date: getDateForWeekday(match[1]),
                        time: normalizeTime(match[2])
                    })
                },
                // Standard order without "at": "task monday 6pm" or "task friday 9:30am"
                {
                    regex: /^(.+?)\s+(monday|tuesday|wednesday|thursday|friday|saturday|sunday)\s+(.+\S.*)$/i,
                    parser: (match) => {
                        const timeResult = normalizeTime(match[3]);
                        if (timeResult) {
                            return {
                                title: match[1].trim(),
                                date: getDateForWeekday(match[2]),
                                time: timeResult
                            };
                        }
                        return null;
                    }
                },
                // Reverse order without "at": "monday 6pm task"
                {
                    regex: /^(monday|tuesday|wednesday|thursday|friday|saturday|sunday)\s+(.+\S.*)\s+(.+)$/i,
                    parser: (match) => {
                        const timeResult = normalizeTime(match[2]);
                        if (timeResult) {
                            return {
                                title: match[3].trim(),
                                date: getDateForWeekday(match[1]),
                                time: timeResult
                            };
                        }
                        return null;
                    }
                },
                // Standard order: "task tomorrow" or "task today"
                {
                    regex: /^(.+?)\s+(today|tomorrow)$/i,
                    parser: (match) => ({
                        title: match[1].trim(),
                        date: getDateForRelative(match[2]),
                        time: '06:00'
                    })
                },
                // Reverse order: "tomorrow task"
                {
                    regex: /^(today|tomorrow)\s+(.+)$/i,
                    parser: (match) => ({
                        title: match[2].trim(),
                        date: getDateForRelative(match[1]),
                        time: '06:00'
                    })
                },
                // Standard order: "task on monday" or "task on friday"
                {
                    regex: /^(.+?)\s+on\s+(monday|tuesday|wednesday|thursday|friday|saturday|sunday)$/i,
                    parser: (match) => ({
                        title: match[1].trim(),
                        date: getDateForWeekday(match[2]),
                        time: '06:00'
                    })
                },
                // Reverse order: "on monday task"
                {
                    regex: /^on\s+(monday|tuesday|wednesday|thursday|friday|saturday|sunday)\s+(.+)$/i,
                    parser: (match) => ({
                        title: match[2].trim(),
                        date: getDateForWeekday(match[1]),
                        time: '06:00'
                    })
                },
                // Standard order with relative periods and time: "task in 3 weeks at 6pm"
                {
                    regex: /^(.+?)\s+in\s+(\d+)\s+(days?|weeks?|months?|years?)\s+at\s+(.+)$/i,
                    parser: (match) => ({
                        title: match[1].trim(),
                        date: getDateForRelativePeriod(match[2], match[3]),
                        time: normalizeTime(match[4])
                    })
                },
                // Standard order with "in a" and time: "task in a month at 9am"
                {
                    regex: /^(.+?)\s+in\s+a\s+(day|week|month|year)\s+at\s+(.+)$/i,
                    parser: (match) => ({
                        title: match[1].trim(),
                        date: getDateForRelativePeriod('a', match[2]),
                        time: normalizeTime(match[3])
                    })
                },
                // Reverse order with relative periods and time: "in 3 weeks at 6pm task"
                {
                    regex: /^in\s+(\d+)\s+(days?|weeks?|months?|years?)\s+at\s+(.+?)\s+(.+)$/i,
                    parser: (match) => ({
                        title: match[4].trim(),
                        date: getDateForRelativePeriod(match[1], match[2]),
                        time: normalizeTime(match[3])
                    })
                },
                // Reverse order with "in a" and time: "in a month at 9am task"
                {
                    regex: /^in\s+a\s+(day|week|month|year)\s+at\s+(.+?)\s+(.+)$/i,
                    parser: (match) => ({
                        title: match[3].trim(),
                        date: getDateForRelativePeriod('a', match[1]),
                        time: normalizeTime(match[2])
                    })
                },
                // Standard order with relative periods without "at": "task in 3 weeks 6pm"
                {
                    regex: /^(.+?)\s+in\s+(\d+)\s+(days?|weeks?|months?|years?)\s+(.+)$/i,
                    parser: (match) => {
                        const timeResult = normalizeTime(match[4]);
                        if (timeResult) {
                            return {
                                title: match[1].trim(),
                                date: getDateForRelativePeriod(match[2], match[3]),
                                time: timeResult
                            };
                        }
                        return null;
                    }
                },
                // Standard order with "in a" without "at": "task in a month 9am"
                {
                    regex: /^(.+?)\s+in\s+a\s+(day|week|month|year)\s+(.+)$/i,
                    parser: (match) => {
                        const timeResult = normalizeTime(match[3]);
                        if (timeResult) {
                            return {
                                title: match[1].trim(),
                                date: getDateForRelativePeriod('a', match[2]),
                                time: timeResult
                            };
                        }
                        return null;
                    }
                },
                // Reverse order with relative periods without "at": "in 3 weeks 6pm task"
                {
                    regex: /^in\s+(\d+)\s+(days?|weeks?|months?|years?)\s+(.+?)\s+(.+)$/i,
                    parser: (match) => {
                        const timeResult = normalizeTime(match[3]);
                        if (timeResult) {
                            return {
                                title: match[4].trim(),
                                date: getDateForRelativePeriod(match[1], match[2]),
                                time: timeResult
                            };
                        }
                        return null;
                    }
                },
                // Reverse order with "in a" without "at": "in a month 9am task"
                {
                    regex: /^in\s+a\s+(day|week|month|year)\s+(.+?)\s+(.+)$/i,
                    parser: (match) => {
                        const timeResult = normalizeTime(match[2]);
                        if (timeResult) {
                            return {
                                title: match[3].trim(),
                                date: getDateForRelativePeriod('a', match[1]),
                                time: timeResult
                            };
                        }
                        return null;
                    }
                },
                // Standard order with relative periods only: "task in 3 weeks"
                {
                    regex: /^(.+?)\s+in\s+(\d+)\s+(days?|weeks?|months?|years?)$/i,
                    parser: (match) => ({
                        title: match[1].trim(),
                        date: getDateForRelativePeriod(match[2], match[3]),
                        time: '06:00'
                    })
                },
                // Standard order with "in a" only: "task in a month"
                {
                    regex: /^(.+?)\s+in\s+a\s+(day|week|month|year)$/i,
                    parser: (match) => ({
                        title: match[1].trim(),
                        date: getDateForRelativePeriod('a', match[2]),
                        time: '06:00'
                    })
                },
                // Reverse order with relative periods only: "in 3 weeks task"
                {
                    regex: /^in\s+(\d+)\s+(days?|weeks?|months?|years?)\s+(.+)$/i,
                    parser: (match) => ({
                        title: match[3].trim(),
                        date: getDateForRelativePeriod(match[1], match[2]),
                        time: '06:00'
                    })
                },
                // Reverse order with "in a" only: "in a month task"
                {
                    regex: /^in\s+a\s+(day|week|month|year)\s+(.+)$/i,
                    parser: (match) => ({
                        title: match[2].trim(),
                        date: getDateForRelativePeriod('a', match[1]),
                        time: '06:00'
                    })
                },
                // Standard order: "task at 6pm" (for today)
                {
                    regex: /^(.+?)\s+at\s+(.+)$/i,
                    parser: (match) => ({
                        title: match[1].trim(),
                        date: getLocalDateString(new Date()), // today
                        time: normalizeTime(match[2])
                    })
                },
                // Reverse order: "at 6pm task" (for today)
                {
                    regex: /^at\s+(.+?)\s+(.+)$/i,
                    parser: (match) => ({
                        title: match[2].trim(),
                        date: getLocalDateString(new Date()), // today
                        time: normalizeTime(match[1])
                    })
                }
            ];
            
            // Try each pattern
            for (const pattern of patterns) {
                const match = original.match(pattern.regex);
                if (match) {
                    const result = pattern.parser(match);
                    if (result.title && (result.date || result.time)) {
                        // Check if title contains @ template and preserve it
                        const templateMatch = result.title.match(/@\w+/);
                        if (templateMatch) {
                            result.template = templateMatch[0];
                        }
                        return result;
                    }
                }
            }
            
            return null;
        }

