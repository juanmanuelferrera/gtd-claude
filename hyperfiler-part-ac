        function openDownloadsFolder() {
            console.log('openDownloadsFolder called');
            
            try {
                // Check if we have showNotification function available
                const hasNotification = typeof showNotification === 'function';
                
                // For Electron or desktop apps with shell access
                if (typeof window !== 'undefined' && window.require) {
                    try {
                        const { shell } = window.require('electron');
                        const path = window.require('path');
                        const os = window.require('os');
                        shell.showItemInFolder(path.join(os.homedir(), 'Downloads'));
                        console.log('Opened Downloads via Electron');
                        return;
                    } catch (e) {
                        console.log('Electron method failed:', e);
                    }
                }
                
                // Try different browser approaches
                const userAgent = navigator.userAgent.toLowerCase();
                let attempted = false;
                
                try {
                    if (userAgent.includes('mac')) {
                        // macOS - try different approaches
                        const username = navigator.platform.includes('Mac') ? (window.navigator.userAgent.match(/\(([^)]+)\)/)?.[1] || 'Downloads') : 'Downloads';
                        
                        // Try to trigger download of a link that opens folder
                        const link = document.createElement('a');
                        link.href = 'file:///Users/' + (process.env.USER || process.env.LOGNAME || username) + '/Downloads/';
                        link.target = '_blank';
                        link.click();
                        attempted = true;
                        console.log('Attempted macOS file:// link');
