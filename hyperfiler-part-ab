        // List Item Drag and Drop Functions
        let draggedListItemIndex = -1;
        
        function handleListItemDragStart(event, index) {
            draggedListItemIndex = index;
            event.target.classList.add('dragging');
            document.getElementById('listItemsContainer').classList.add('dragging-active');
            
            // Set drag effect
            event.dataTransfer.effectAllowed = 'move';
            event.dataTransfer.setData('text/html', event.target.outerHTML);
        }
        
        function handleListItemDragEnd(event) {
            event.target.classList.remove('dragging');
            document.getElementById('listItemsContainer').classList.remove('dragging-active');
            
            // Clear all drag-over states
            document.querySelectorAll('.list-modal-item').forEach(item => {
                item.classList.remove('drag-over', 'drag-over-bottom');
            });
            
            draggedListItemIndex = -1;
        }
        
        function handleListItemDragOver(event) {
            event.preventDefault();
            event.dataTransfer.dropEffect = 'move';
            
            const target = event.currentTarget;
            const targetIndex = parseInt(target.dataset.itemIndex);
            
            if (targetIndex === draggedListItemIndex) return;
            
            // Clear previous drag-over states
            document.querySelectorAll('.list-modal-item').forEach(item => {
                item.classList.remove('drag-over', 'drag-over-bottom');
            });
            
            // Determine if we're dragging above or below the target
            const rect = target.getBoundingClientRect();
            const midY = rect.top + rect.height / 2;
            const isAbove = event.clientY < midY;
            
            if (isAbove) {
                target.classList.add('drag-over');
            } else {
                target.classList.add('drag-over-bottom');
            }
        }
        
        async function handleListItemDrop(event, dropIndex) {
            event.preventDefault();
            
            if (draggedListItemIndex === -1 || draggedListItemIndex === dropIndex) return;
            
            const section = listSections.find(s => s.id == currentListSectionId);
            if (!section) return;
            
            const list = section.lists.find(l => l.id == currentListId);
            if (!list || !list.items) return;
            
            // Determine final position based on drop indicator
            const target = event.currentTarget;
            const rect = target.getBoundingClientRect();
            const midY = rect.top + rect.height / 2;
            const isAbove = event.clientY < midY;
            
            let newIndex = dropIndex;
            if (!isAbove) {
                newIndex = dropIndex + 1;
            }
            
            // Adjust for the fact that we're removing an item
            if (draggedListItemIndex < newIndex) {
                newIndex--;
            }
            
            // Perform the array manipulation
            const draggedItem = list.items[draggedListItemIndex];
            list.items.splice(draggedListItemIndex, 1);
            list.items.splice(newIndex, 0, draggedItem);
            
            // Save changes and re-render
            await saveListSections();
            renderListItems();
            renderListsView(); // Update counts in main view
            
            // Clear drag states
            target.classList.remove('drag-over', 'drag-over-bottom');
        }
        
