                        <div class="list-modal-item-content">
                            <input type="checkbox" 
                                   class="list-modal-item-checkbox list-modal-select-checkbox" 
                                   ${item.completed ? 'checked' : ''} 
                                   onchange="toggleListItem(${originalIndex}); updateConvertButtons()">
                            <div class="list-modal-item-text">${escapeHtml(item.text)}</div>
                        </div>
