        // Generate time options for dropdown with calculated times
        function generateTimeAdjustmentOptions(currentTime) {
            // Get current time or default to current hour
            let baseTime;
            if (currentTime) {
                baseTime = currentTime;
            } else {
                // If no time set, use current hour
                const now = new Date();
                baseTime = String(now.getHours()).padStart(2, '0') + ':00';
            }
            
            // Parse current time
            const [currentHour, currentMinute] = baseTime.split(':').map(Number);
            
            // Define hour adjustments
            const hourAdjustments = [-12, -8, -6, -4, -2, -1, 0, 1, 2, 4, 6, 8, 12];
            
            let options = '';
            
            for (const adjustment of hourAdjustments) {
                // Calculate new time
                let newHour = currentHour + adjustment;
                let newMinute = currentMinute;
                
                // Handle day overflow/underflow
                let dayIndicator = '';
                if (newHour >= 24) {
                    newHour = newHour % 24;
                    dayIndicator = ' (+1d)';
                } else if (newHour < 0) {
                    newHour = (newHour % 24) + 24;
                    dayIndicator = ' (-1d)';
                }
                
                // Format time
                const formattedTime = String(newHour).padStart(2, '0') + ':' + String(newMinute).padStart(2, '0');
                
                // Create display text
                let displayText;
                if (adjustment === 0) {
                    displayText = `${formattedTime}`;
                } else {
                    const sign = adjustment > 0 ? '+' : '';
                    displayText = `${formattedTime} (${sign}${adjustment}h)${dayIndicator}`;
                }
                
                const isSelected = adjustment === 0 ? 'selected' : '';
                options += `<option value="${adjustment}" ${isSelected}>${displayText}</option>`;
            }
            
            return options;
        }
        
