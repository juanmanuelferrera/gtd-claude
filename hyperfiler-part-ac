        // Function to convert URLs to clickable links and process checkbox lists
        function getTruncatedNotes(notes, maxLines) {
            if (!notes) return '';
            
            // Split text by actual line breaks
            const lines = notes.split('\n');
            
            if (lines.length <= maxLines) {
                return makeLinksClickable(notes);
            }
            
            // Take only the first maxLines and add ellipsis
            const truncatedText = lines.slice(0, maxLines).join('\n');
            return makeLinksClickable(truncatedText) + '<span style="color: #999; font-style: italic;">...</span>';
        }

        // Function to extract tags from text and return clean text without tags
        function extractTagsAndCleanText(text) {
            if (!text) return { cleanText: '', tags: [] };
            
            // Extract all tags (@word patterns)
            const tagRegex = /@\w+/g;
            const tags = text.match(tagRegex) || [];
            
            // Remove tags from text, also removing extra spaces
            const cleanText = text.replace(tagRegex, '').replace(/\s+/g, ' ').trim();
            
            return { cleanText, tags };
        }
        
        // Function to check if a task has any tags (in title or notes)
        function hasTaskTags(task) {
            const titleTags = (task.title.match(/@\w+/g) || []).length > 0;
            const notesTags = (task.notes && task.notes.match(/@\w+/g) || []).length > 0;
            return titleTags || notesTags;
        }
        
        // Function to render task title with clean text and tag indicator
        function renderTaskTitle(task, prefix = '', suffix = '') {
            const { cleanText } = extractTagsAndCleanText(task.title);
            const tagIndicator = hasTaskTags(task) ? ` <span style="color: #999; font-size: 14px;">🏷️</span>` : '';
            return `${prefix}${makeLinksClickable(cleanText)}${tagIndicator}${suffix}`;
        }

        function makeLinksClickable(text) {
            if (!text) return '';
            
            // First, extract and process images
            const imageRegex = /\[IMG:(\d+):(data:image\/[^;]+;base64,[^\]]+)\]/g;
            let processed = text.replace(imageRegex, (match, id, dataUrl) => {
                return `<div class="note-image-display" style="display: inline-block; margin: 4px; border: 1px solid #ddd; border-radius: 4px; overflow: hidden;">
                    <img src="${dataUrl}" alt="Image" style="max-width: 150px; max-height: 150px; object-fit: cover; display: block; cursor: pointer;" onclick="viewImageFullSize('${dataUrl}', event)">
                </div>`;
            });
            
            // Regular expression to match URLs
            const urlRegex = /(https?:\/\/[^\s]+)/g;
            
            // Convert URLs to clickable links with event propagation prevention
            processed = processed.replace(urlRegex, '<a href="$1" target="_blank" rel="noopener noreferrer" onclick="event.stopPropagation()" style="color: #1877f2; text-decoration: underline;">$1</a>');
            
            // Process checkbox lists
            processed = processCheckboxLists(processed);
            
            return processed;
        }
        
        // Function to process checkbox lists in text
        function processCheckboxLists(text) {
            if (!text) return '';
            
            // Replace unchecked checkboxes: - [ ] -> interactive checkbox
            text = text.replace(/^(\s*)- \[ \]\s*(.+)$/gm, (match, indent, content) => {
                const taskId = Math.random().toString(36).substr(2, 9);
                return `${indent}<div class="checkbox-item" style="display: flex; align-items: flex-start; margin: 4px 0; gap: 8px;">
                    <input type="checkbox" id="cb_${taskId}" onchange="toggleCheckboxInNotes(this)" style="margin-top: 2px; cursor: pointer;">
                    <label for="cb_${taskId}" style="flex: 1; cursor: pointer; line-height: 1.4;">${content}</label>
                </div>`;
            });
            
            // Replace checked checkboxes: - [x] -> checked interactive checkbox
            text = text.replace(/^(\s*)- \[x\]\s*(.+)$/gm, (match, indent, content) => {
                const taskId = Math.random().toString(36).substr(2, 9);
                return `${indent}<div class="checkbox-item" style="display: flex; align-items: flex-start; margin: 4px 0; gap: 8px;">
                    <input type="checkbox" id="cb_${taskId}" checked onchange="toggleCheckboxInNotes(this)" style="margin-top: 2px; cursor: pointer;">
                    <label for="cb_${taskId}" style="flex: 1; cursor: pointer; line-height: 1.4; text-decoration: line-through; opacity: 0.7;">${content}</label>
                </div>`;
            });
            
            return text;
        }
        

