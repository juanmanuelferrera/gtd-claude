            const now = new Date();
            const lastWeekly = backupSettings.lastWeeklyBackup ? new Date(backupSettings.lastWeeklyBackup) : null;
            
            // Only backup if it's been at least 6.5 days (prevent duplicates)
            if (!lastWeekly || (now - lastWeekly) >= 6.5 * 24 * 60 * 60 * 1000) {
                console.log('💾 Creating weekly backup - Last backup:', lastWeekly ? lastWeekly.toISOString() : 'never');
                createAutomaticBackup('weekly');
                storeAutomaticBackup('weekly'); // Also store for restoration
                backupSettings.lastWeeklyBackup = now.toISOString();
                saveBackupSettings();
                
