                    'content_merge': 'Smart content merging',
                    'manual_review': 'Require manual resolution'
                },
                
                // Detect potential conflicts before they occur
                async detectConflict(taskId, localTask, serverTask) {
                    try {
                        if (!localTask || !serverTask) {
                            return null; // No conflict if one doesn't exist
                        }
                        
                        const localTimestamp = new Date(localTask.updatedAt || localTask.lastModified || 0);
                        const serverTimestamp = new Date(serverTask.updatedAt || serverTask.lastModified || 0);
                        const timeDiff = Math.abs(localTimestamp - serverTimestamp);
                        
                        // Check for simultaneous edits (within 30 seconds)
                        const isSimultaneous = timeDiff < 30000;
                        
                        // Detect field-level conflicts
                        const fieldConflicts = [];
                        const fields = ['title', 'notes', 'dueDate', 'dueTime', 'status', 'priority'];
                        
                        fields.forEach(field => {
                            const localValue = localTask[field] || '';
                            const serverValue = serverTask[field] || '';
                            
                            if (localValue !== serverValue) {
                                fieldConflicts.push({
                                    field,
                                    localValue,
                                    serverValue,
                                    conflictType: this.getConflictType(localValue, serverValue)
                                });
                            }
                        });
                        
                        if (fieldConflicts.length === 0) {
                            return null; // No actual conflicts
                        }
                        
                        const conflict = {
                            id: `conflict_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`,
                            taskId,
                            timestamp: new Date().toISOString(),
                            localTimestamp: localTimestamp.toISOString(),
                            serverTimestamp: serverTimestamp.toISOString(),
                            isSimultaneous,
                            timeDiff,
                            fieldConflicts,
                            severity: this.calculateSeverity(fieldConflicts, isSimultaneous),
                            status: 'detected', // detected, resolved, manual_pending
                            userId: window.currentUser?.user?.id,
                            resolutionStrategy: null,
                            resolvedAt: null
                        };
                        
                        // console.log(`📋 Layer 3: Conflict detected for task ${taskId}`, {
                        //     severity: conflict.severity,
                        //     fields: fieldConflicts.length,
                        //     simultaneous: isSimultaneous
                        // });
                        
                        return conflict;
                    } catch (error) {
                        console.error('❌ Layer 3: Conflict detection failed:', error);
                        return null;
                    }
                },
                
                // Smart automatic resolution
                async resolveConflict(conflict, strategy = 'auto') {
                    try {
                        if (!conflict || !conflict.fieldConflicts) {
                            throw new Error('Invalid conflict data');
                        }
                        
                        const taskId = conflict.taskId;
                        const localTask = tasks.find(t => t.id === taskId);
                        
                        if (!localTask) {
                            throw new Error(`Task ${taskId} not found locally`);
                        }
                        
                        let resolvedTask = { ...localTask };
                        let resolutionLog = [];
                        
                        // Determine strategy if auto
                        if (strategy === 'auto') {
                            strategy = this.determineAutoStrategy(conflict);
                        }
                        
                        // Apply resolution strategy
                        switch (strategy) {
                            case 'timestamp_priority':
                                // Use the most recent version
                                if (new Date(conflict.serverTimestamp) > new Date(conflict.localTimestamp)) {
                                    conflict.fieldConflicts.forEach(fc => {
                                        resolvedTask[fc.field] = fc.serverValue;
                                        resolutionLog.push(`${fc.field}: Used server value (newer timestamp)`);
                                    });
                                } else {
                                    resolutionLog.push('Used local values (newer timestamp)');
                                }
                                break;
                                
                            case 'content_merge':
                                // Smart content merging for text fields
                                conflict.fieldConflicts.forEach(fc => {
                                    if (fc.field === 'notes' || fc.field === 'title') {
                                        const merged = this.smartTextMerge(fc.localValue, fc.serverValue);
                                        resolvedTask[fc.field] = merged;
                                        resolutionLog.push(`${fc.field}: Smart merged content`);
                                    } else {
                                        // For non-text fields, use timestamp priority
                                        if (new Date(conflict.serverTimestamp) > new Date(conflict.localTimestamp)) {
                                            resolvedTask[fc.field] = fc.serverValue;
                                            resolutionLog.push(`${fc.field}: Used server value`);
                                        }
                                    }
                                });
                                break;
                                
                            case 'user_priority':
                                // Always prefer current user's changes
                                resolutionLog.push('Used local values (user priority)');
                                break;
                                
                            default:
                                throw new Error(`Unknown resolution strategy: ${strategy}`);
                        }
                        
                        // Update conflict record
                        conflict.status = 'resolved';
                        conflict.resolutionStrategy = strategy;
                        conflict.resolvedAt = new Date().toISOString();
                        conflict.resolutionLog = resolutionLog;
                        
                        // Log the conflict
                        await this.logConflict(conflict);
                        
                        // Update the task with resolved data
                        resolvedTask.updatedAt = new Date().toISOString();
                        const taskIndex = tasks.findIndex(t => t.id === taskId);
                        if (taskIndex >= 0) {
                            tasks[taskIndex] = resolvedTask;
                        }
                        
                        // console.log(`📋 Layer 3: Conflict resolved using ${strategy}`, {
                        //     taskId,
                        //     strategy,
                        //     changes: resolutionLog.length
                        // });
                        
                        return resolvedTask;
                    } catch (error) {
                        console.error('❌ Layer 3: Conflict resolution failed:', error);
                        
                        // Mark as requiring manual resolution
                        conflict.status = 'manual_pending';
                        conflict.error = error.message;
                        await this.logConflict(conflict);
                        
                        return null;
                    }
                },
                
                // Smart text merging algorithm
                smartTextMerge(localText, serverText) {
                    try {
                        if (!localText && !serverText) return '';
                        if (!localText) return serverText;
                        if (!serverText) return localText;
                        if (localText === serverText) return localText;
                        
                        // Simple merge strategy: combine unique content
                        const localLines = localText.split('\n').map(l => l.trim()).filter(l => l);
                        const serverLines = serverText.split('\n').map(l => l.trim()).filter(l => l);
                        
                        // Find common lines and unique additions
                        const allLines = [...new Set([...localLines, ...serverLines])];
                        
                        // If texts are completely different, create a merged version
                        if (localLines.every(l => !serverLines.includes(l))) {
                            return `${localText}\n\n--- Merged from server ---\n${serverText}`;
                        }
                        
                        return allLines.join('\n');
                    } catch (error) {
                        console.warn('Smart text merge failed, using local text:', error);
                        return localText;
                    }
                },
                
                // Determine automatic resolution strategy
                determineAutoStrategy(conflict) {
                    // High severity conflicts require manual review
                    if (conflict.severity === 'high') {
                        return 'manual_review';
                    }
                    
                    // If mostly text changes, try content merge
                    const textFields = conflict.fieldConflicts.filter(fc => 
                        fc.field === 'title' || fc.field === 'notes'
                    );
                    
                    if (textFields.length > 0 && conflict.fieldConflicts.length <= 2) {
                        return 'content_merge';
                    }
                    
                    // For simultaneous edits, prefer timestamp
                    if (conflict.isSimultaneous) {
                        return 'timestamp_priority';
                    }
                    
                    // Default to user priority for simple conflicts
                    return 'user_priority';
                },
                
                // Calculate conflict severity
                calculateSeverity(fieldConflicts, isSimultaneous) {
                    let score = 0;
                    
                    // Add points based on number of conflicting fields
                    score += fieldConflicts.length;
                    
                    // Critical fields increase severity
                    const criticalFields = ['title', 'dueDate', 'status'];
                    score += fieldConflicts.filter(fc => criticalFields.includes(fc.field)).length * 2;
                    
                    // Simultaneous edits increase severity
                    if (isSimultaneous) score += 2;
                    
                    // Large content changes increase severity
                    fieldConflicts.forEach(fc => {
                        const localLen = (fc.localValue || '').length;
                        const serverLen = (fc.serverValue || '').length;
                        if (Math.abs(localLen - serverLen) > 100) score += 1;
                    });
                    
                    if (score >= 6) return 'high';
                    if (score >= 3) return 'medium';
                    return 'low';
                },
                
                // Get conflict type for a field
                getConflictType(localValue, serverValue) {
                    if (!localValue && serverValue) return 'addition';
                    if (localValue && !serverValue) return 'deletion';
                    if (localValue !== serverValue) return 'modification';
                    return 'none';
                },
                
                // Log conflict to history
                async logConflict(conflict) {
                    try {
                        // Add to logs
                        this.logs.unshift(conflict);
                        
                        // Maintain max logs limit
                        if (this.logs.length > this.maxLogs) {
                            this.logs = this.logs.slice(0, this.maxLogs);
                        }
                        
                        // Save to localStorage
                        localStorage.setItem('tripleProtection_conflicts', JSON.stringify(this.logs));
                        
                        // console.log(`📋 Layer 3: Conflict logged`, {
                        //     id: conflict.id,
                        //     status: conflict.status,
                        //     strategy: conflict.resolutionStrategy
                        // });
                        
                        return true;
                    } catch (error) {
                        console.error('❌ Layer 3: Failed to log conflict:', error);
                        return false;
                    }
                },
                
                // Get conflict statistics
                getStats() {
                    const resolved = this.logs.filter(c => c.status === 'resolved').length;
                    const pending = this.logs.filter(c => c.status === 'manual_pending').length;
                    const auto = this.logs.filter(c => c.resolutionStrategy !== 'manual_review').length;
                    
                    return {
                        totalConflicts: this.logs.length,
                        resolved,
                        pending,
                        autoResolved: auto,
                        manualResolved: resolved - auto,
                        resolutionRate: this.logs.length > 0 ? ((resolved / this.logs.length) * 100).toFixed(1) : 100
                    };
                },
                
                // Load conflict history
                load() {
                    try {
                        const saved = localStorage.getItem('tripleProtection_conflicts');
                        if (saved) {
                            this.logs = JSON.parse(saved);
                            // console.log(`📋 Layer 3: Loaded ${this.logs.length} conflict logs`);
                        }
                    } catch (error) {
                        console.error('❌ Layer 3: Failed to load conflict logs:', error);
                        this.logs = [];
                    }
                },
                
                init() {
