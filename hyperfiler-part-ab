        // Sort tasks by due date and event priority
        function sortTasks() {
            tasks.sort((a, b) => {
                // First sort by completion status (pending first)
                if (a.status !== b.status) {
                    return a.status === 'completed' ? 1 : -1;
                }
                
                // Then by due date (closest first)
                if (a.dueDate && b.dueDate) {
                    const dateA = new Date(a.dueDate + (a.dueTime ? 'T' + a.dueTime : ''));
                    const dateB = new Date(b.dueDate + (b.dueTime ? 'T' + b.dueTime : ''));
                    if (dateA.getTime() !== dateB.getTime()) {
                        return dateA - dateB;
                    }
                    
                    // If same date, prioritize events first
                    if (a.isEvent !== b.isEvent) {
                        return a.isEvent ? -1 : 1;
                    }
                    
                    // If same date and both same event status, sort by time
                    if (a.dueTime && b.dueTime) {
                        return a.dueTime.localeCompare(b.dueTime);
                    }
                    if (a.dueTime && !b.dueTime) return -1;
                    if (!a.dueTime && b.dueTime) return 1;
                }
                
                // If one has date and other doesn't, prioritize the one with date
                if (a.dueDate && !b.dueDate) return -1;
                if (!a.dueDate && b.dueDate) return 1;
                
                // For tasks without dates, prioritize events first
                if (a.isEvent !== b.isEvent) {
                    return a.isEvent ? -1 : 1;
                }
                
                // Finally by creation date (newest first for tasks without dates)
                return new Date(b.createdAt) - new Date(a.createdAt);
            });
        }

