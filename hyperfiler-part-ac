        // Undo to a specific point in history
        async function undoToPoint(targetIndex) {
            if (targetIndex < 0 || targetIndex >= undoStack.length) {
                alert('Invalid undo target');
                return;
            }
            
            const undoCount = undoStack.length - targetIndex;
            const targetState = undoStack[targetIndex];
            
            if (!confirm(`Undo ${undoCount} action(s) back to: "${targetState.action}"?\n\nThis will undo all changes after that point.`)) {
                return;
            }
            
            try {
                // Restore tasks from the target state
                tasks = JSON.parse(JSON.stringify(targetState.tasks));
                
                // Remove all undo states after the target point
                undoStack.splice(targetIndex + 1);
                
                // Clear database and resave all tasks
                if (typeof clearDatabase === 'function') {
                    await clearDatabase();
                }
                
                for (const task of tasks) {
                    await saveTask(task);
                }
                
                sortTasks();
                renderCurrentView();
                renderUndoView(); // Refresh the undo view
                
                // Show feedback
                showUndoNotification(`Undid ${undoCount} action(s) back to: ${targetState.action}`);
                
            } catch (error) {
                console.error('Error performing undo to point:', error);
                alert('❌ Error performing undo. Please try again.');
            }
        }

