        // Adjust task time by specified hours (positive or negative)
        async function adjustTaskTime(taskId, hours, event) {
            event.stopPropagation();
            
            // Reset dropdown to default state
            const dropdown = event.target;
            const resetDropdown = () => {
                setTimeout(() => {
                    dropdown.value = '';
                }, 100);
            };
            
            // Skip if no value selected (default option)
            if (!hours || hours === '') {
                resetDropdown();
                return;
            }
            
            try {
                const task = tasks.find(t => t.id === taskId);
                if (!task) {
                    console.error('Task not found:', taskId);
                    resetDropdown();
                    return;
                }
                
                // Save state for undo
                saveStateForUndo('adjust time', task);
                
                // Get current time or default to current hour
                let currentTime;
                if (task.dueTime) {
                    currentTime = task.dueTime;
                } else {
                    // If no time set, use current hour
                    const now = new Date();
                    currentTime = String(now.getHours()).padStart(2, '0') + ':00';
                }
                
                // Parse current time
                const [currentHour, currentMinute] = currentTime.split(':').map(Number);
                
                // Calculate new time
                let newHour = currentHour + hours;
                let newMinute = currentMinute;
                
                // Handle day overflow/underflow
                let dateAdjustment = 0;
                while (newHour >= 24) {
                    newHour -= 24;
                    dateAdjustment += 1;
                }
                while (newHour < 0) {
                    newHour += 24;
                    dateAdjustment -= 1;
                }
                
                // Format new time
                const newTime = String(newHour).padStart(2, '0') + ':' + String(newMinute).padStart(2, '0');
                
                // Update task time
                task.dueTime = newTime;
                
                // If we crossed day boundaries, adjust the date too
                if (dateAdjustment !== 0 && task.dueDate) {
                    const taskDate = new Date(task.dueDate + 'T00:00:00');
                    taskDate.setDate(taskDate.getDate() + dateAdjustment);
                    task.dueDate = taskDate.toISOString().split('T')[0];
                } else if (dateAdjustment !== 0 && !task.dueDate) {
                    // If no date set but we're adjusting across days, set date
                    const today = new Date();
                    today.setDate(today.getDate() + dateAdjustment);
                    task.dueDate = today.toISOString().split('T')[0];
                }
                
                // Save to database (optimistic update)
                saveTask(task); // Remove await - renderCurrentView already called by saveTask
                
                const action = hours > 0 ? 'forward' : 'backward';
                console.log(`Task "${task.title}" time moved ${action} by ${Math.abs(hours)} hours to ${newTime}`);
                if (dateAdjustment !== 0) {
                    console.log(`Date also adjusted by ${dateAdjustment} day(s)`);
                }
                
                // Reset dropdown after successful adjustment
                resetDropdown();
                
            } catch (error) {
                console.error('Error adjusting task time:', error);
                alert('❌ Error adjusting task time. Please try again.');
                resetDropdown();
            }
        }
        
