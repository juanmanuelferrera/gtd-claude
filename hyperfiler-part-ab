        // Update dynamic month statistics
        function updateMonthStats(year, month) {
            const monthTasks = tasks.filter(task => {
                if (!task.dueDate) return false;
                const taskDate = new Date(task.dueDate + 'T00:00:00');
                return taskDate.getFullYear() === year && taskDate.getMonth() === month;
            });
            
            const events = monthTasks.filter(t => t.isEvent);
            const regularTasks = monthTasks.filter(t => !t.isEvent);
            const completed = monthTasks.filter(t => t.status === 'completed');
            const overdue = monthTasks.filter(t => {
                const today = getLocalDateString(new Date());
                return t.dueDate < today && t.status === 'pending';
            });
            
            const totalActiveTasks = monthTasks.filter(t => !t.isEvent).length;
            const productivity = totalActiveTasks > 0 ? Math.round((completed.filter(t => !t.isEvent).length / totalActiveTasks) * 100) : 0;
            
            // Build dynamic statistics array with only relevant data
            const stats = [];
            
            if (events.length > 0) {
                stats.push(`📅 ${events.length} Event${events.length !== 1 ? 's' : ''}`);
            }
            
            if (regularTasks.length > 0) {
                stats.push(`📋 ${regularTasks.length} Task${regularTasks.length !== 1 ? 's' : ''}`);
            }
            
            if (completed.length > 0) {
                stats.push(`✅ ${completed.length} Done`);
            }
            
            
            if (totalActiveTasks > 0 && productivity > 0) {
                stats.push(`🎯 ${productivity}% Complete`);
            }
            
            // Calculate percentage of days with tasks
            const daysInMonth = new Date(year, month + 1, 0).getDate();
            const daysWithTasks = new Set();
            monthTasks.forEach(task => {
                if (task.dueDate) {
                    daysWithTasks.add(task.dueDate);
                }
            });
            const percentDaysWithTasks = Math.round((daysWithTasks.size / daysInMonth) * 100);
            
            // Show interesting insights if we have data
            if (monthTasks.length === 0) {
                stats.push(`🌟 Free Month!`);
            } else if (productivity === 100) {
                stats.push(`🏆 Perfect Month!`);
            } else if (percentDaysWithTasks > 0) {
                stats.push(`📅 ${percentDaysWithTasks}% Days with Tasks`);
            }
            
            // Update the container with dynamic content
            const monthStatsContainer = document.querySelector('#monthStats > div');
            if (monthStatsContainer) {
                monthStatsContainer.innerHTML = stats.map(stat => `<span>${stat}</span>`).join('');
            }
            
            // Add color coding based on productivity
            const monthStats = document.getElementById('monthStats');
            if (monthStats) {
                let gradient = '#667eea 0%, #764ba2 100%'; // Default purple
                if (productivity >= 80) {
                    gradient = '#56ab2f 0%, #a8e6cf 100%'; // Green for high productivity
