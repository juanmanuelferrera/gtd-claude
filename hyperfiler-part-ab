        // Pause a repeat series (prevents generating new instances)
        function pauseRepeatSeries(taskId) {
            const representativeTask = tasks.find(t => t.id == taskId);
            if (!representativeTask) return;
            
            const taskTitle = representativeTask.title;
            const allTasksWithTitle = tasks.filter(task => task.title === taskTitle);
            
            if (confirm(`Pause the repeat series "${taskTitle}"?\n\nThis will prevent new instances from being generated automatically. You can resume it later.`)) {
                // Add a paused flag to all tasks in the series
                allTasksWithTitle.forEach(task => {
                    task.repeatPaused = true;
                    task.repeatPausedDate = getLocalDateString();
                });
                
                alert(`✅ Series "${taskTitle}" has been paused.\n\nNo new instances will be generated until you resume it.`);
                renderRepeatView();
                renderCurrentView();
            }
        }

        // Resume a paused repeat series
        function resumeRepeatSeries(taskId) {
            const representativeTask = tasks.find(t => t.id == taskId);
            if (!representativeTask) return;
            
            const taskTitle = representativeTask.title;
            const allTasksWithTitle = tasks.filter(task => task.title === taskTitle);
            
            if (confirm(`Resume the repeat series "${taskTitle}"?\n\nThis will allow new instances to be generated automatically again.`)) {
                // Remove the paused flag from all tasks in the series
                allTasksWithTitle.forEach(task => {
                    delete task.repeatPaused;
                    delete task.repeatPausedDate;
                });
                
                alert(`✅ Series "${taskTitle}" has been resumed.\n\nNew instances will be generated according to the repeat schedule.`);
                renderRepeatView();
                renderCurrentView();
            }
        }

        // Skip the next occurrence of a repeat series
        function skipNextRepeat(taskId) {
            const representativeTask = tasks.find(t => t.id == taskId);
            if (!representativeTask) return;
            
            const taskTitle = representativeTask.title;
            const today = getLocalDateString();
            
            // Find the next pending instance
            const allTasksWithTitle = tasks.filter(task => task.title === taskTitle);
            const upcomingTasks = allTasksWithTitle.filter(task => 
                task.status === 'pending' && 
                (!task.dueDate || task.dueDate >= today)
            ).sort((a, b) => (a.dueDate || '').localeCompare(b.dueDate || ''));
            
            if (upcomingTasks.length === 0) {
                alert('No upcoming instances found to skip.');
                return;
            }
            
            const nextTask = upcomingTasks[0];
            const nextDate = nextTask.dueDate ? formatDate(new Date(nextTask.dueDate)) : 'No date';
            
            if (confirm(`Skip the next occurrence on ${nextDate}?\n\nThis will mark it as completed and move to the following instance.`)) {
                // Mark the next instance as completed with a note
                nextTask.status = 'completed';
                nextTask.notes = (nextTask.notes || '') + '\n[Skipped on ' + formatDate(new Date()) + ']';
                nextTask.completedAt = new Date().toISOString();
                
                alert(`✅ Next occurrence on ${nextDate} has been skipped.`);
                renderRepeatView();
                renderCurrentView();
            }
        }

