                if (!shouldConfirm || confirm(`Delete "${task.title}"?`)) {
                    // Store task for undo before deletion
                    saveStateForUndo('delete single task instance');
                    
                    // Remove from local array
                    tasks = tasks.filter(t => t.id != taskId);
                    
                    // VERSION 2: Clean up Event Registry
                    unmarkAsEvent(taskId);
                    
                    // Save using standard pattern
