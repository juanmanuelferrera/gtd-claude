        function switchLanguage(lang) {
            currentLanguage = lang;
            localStorage.setItem('preferredLanguage', lang);
            translateUI();
            updateLanguageButtonStyles();
            updateHeaderLanguageButton();
            
            // CRITICAL: Always restore emojis after language changes
            setTimeout(() => {
                restoreMobileNavEmojis();
            }, 100);
        }
        
        function toggleLanguageHeader() {
            const newLang = currentLanguage === 'en' ? 'es' : 'en';
            switchLanguage(newLang);
        }
        
        function updateHeaderLanguageButton() {
            const btn = document.getElementById('language-toggle-btn');
            if (btn) {
                // Show the flag of the language it will switch TO, not the current language
                btn.textContent = currentLanguage === 'en' ? '🇪🇸' : '🇬🇧';
                btn.title = currentLanguage === 'en' ? 'Switch to Spanish / Cambiar a Español' : 'Switch to English / Cambiar a Inglés';
            }
        }
        
        function toggleKeyboardOnlyModeHeader() {
            const checkbox = document.getElementById('keyboardOnlyMode');
            if (checkbox) {
                checkbox.checked = !checkbox.checked;
                toggleKeyboardOnlyMode();
                updateHeaderKeyboardButton();
                // Note: toggleKeyboardOnlyMode() already handles showing the shortcuts modal
            }
        }
        
        function openQuickImportModal() {
            document.getElementById('quickImportModal').style.display = 'block';
        }
        
        function closeQuickImportModal(event) {
            if (!event || event.target === document.getElementById('quickImportModal')) {
                document.getElementById('quickImportModal').style.display = 'none';
            }
        }
        
        function updateHeaderKeyboardButton() {
            const btn = document.getElementById('keyboard-mode-toggle-btn');
