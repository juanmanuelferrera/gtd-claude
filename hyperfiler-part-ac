            // Don't focus to prevent native dropdown opening
            // timeSelect.focus();
            
            // Create custom keyboard navigation overlay
            let selectedIndex = timeSelect.selectedIndex;
            const options = Array.from(timeSelect.options);

            function updateSelection() {
                timeSelect.selectedIndex = selectedIndex;
                // Update visual indicator
                timeSelect.style.background = '#1877f2';
                timeSelect.style.color = 'white';
                console.log('⏰ Selected option:', options[selectedIndex].text, 'Value:', options[selectedIndex].value);
            }
            updateSelection();

            function handleKeyDown(event) {
                // Prevent all default behavior to override native dropdown
                event.preventDefault();
                event.stopPropagation();
                
                switch (event.key) {
                    case 'ArrowUp':
                        selectedIndex = Math.max(0, selectedIndex - 1);
                        updateSelection();
                        break;
                    case 'ArrowDown':
                        selectedIndex = Math.min(options.length - 1, selectedIndex + 1);
                        updateSelection();
                        break;
                    case 'Enter':
                        // Get the selected value and call updateTaskTime directly
                        const newTime = options[selectedIndex].value;
                        cleanupKeyboardNav();
                        // Call updateTaskTime directly with a fake event
                        updateTaskTime(taskId, newTime, { stopPropagation: () => {} });
                        break;
                    case 'Escape':
                        cleanupKeyboardNav();
                        break;
                }
            }

            function cleanupKeyboardNav() {
                timeDropdownActive = false;
                document.removeEventListener('keydown', handleKeyDown, true);
                // Reset all the enhanced styles
                timeSelect.style.fontSize = '';
                timeSelect.style.padding = '';
                timeSelect.style.minWidth = '';
                timeSelect.style.border = '';
                timeSelect.style.borderRadius = '';
                timeSelect.style.background = '';
                timeSelect.style.color = '';
                timeSelect.style.fontWeight = '';
                timeSelect.style.boxShadow = '';
                timeSelect.style.zIndex = '';
                timeSelect.blur();
                console.log('⏰ Time dropdown navigation closed');
            }

            // Add keyboard event listener with highest priority
            document.addEventListener('keydown', handleKeyDown, { capture: true, passive: false });

            // Clean up when clicking outside
            function handleClickOutside(event) {
                if (!timeSelect.contains(event.target)) {
                    cleanupKeyboardNav();
                    document.removeEventListener('click', handleClickOutside);
                }
            }
            document.addEventListener('click', handleClickOutside);

            console.log('⏰ Enhanced keyboard navigation added to existing dropdown');
        }

