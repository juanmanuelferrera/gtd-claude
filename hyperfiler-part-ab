        function formatBackupDate(date) {
            if (!date || isNaN(date.getTime())) return 'Never';
            
            const now = new Date();
            const diffMs = date - now; // Changed to handle future dates
            const diffDays = Math.floor(Math.abs(diffMs) / (1000 * 60 * 60 * 24));
            const diffHours = Math.floor(Math.abs(diffMs) / (1000 * 60 * 60));
            const diffMinutes = Math.floor(Math.abs(diffMs) / (1000 * 60));

            let timeAgo = '';
            if (diffMs > 0) {
                // Future date
                if (diffDays > 0) {
                    timeAgo = `in ${diffDays} day${diffDays !== 1 ? 's' : ''}`;
                } else if (diffHours > 0) {
                    timeAgo = `in ${diffHours} hour${diffHours !== 1 ? 's' : ''}`;
                } else if (diffMinutes > 0) {
                    timeAgo = `in ${diffMinutes} minute${diffMinutes !== 1 ? 's' : ''}`;
                } else {
                    timeAgo = 'Soon';
                }
            } else {
                // Past date
                if (diffDays > 0) {
                    timeAgo = `${diffDays} day${diffDays !== 1 ? 's' : ''} ago`;
                } else if (diffHours > 0) {
                    timeAgo = `${diffHours} hour${diffHours !== 1 ? 's' : ''} ago`;
                } else if (diffMinutes > 0) {
                    timeAgo = `${diffMinutes} minute${diffMinutes !== 1 ? 's' : ''} ago`;
                } else {
                    timeAgo = 'Just now';
                }
            }

            return `${date.toLocaleDateString()} ${date.toLocaleTimeString()} (${timeAgo})`;
        }

