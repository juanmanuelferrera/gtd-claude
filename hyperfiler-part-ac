                    }
                };
                
                // Apply immediately
                applyHighlight();
                
                // Create persistent interval - but only apply if needed
                this.interval = setInterval(applyHighlight, 500); // Reduced frequency
            },
            
            restoreAfterRender: function() {
                if (this.isActive && this.taskId) {
