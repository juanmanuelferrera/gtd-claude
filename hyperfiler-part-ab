        // Import TXT file - handles both structured and simple import
        function importTXTFile() {
            const importMode = document.querySelector('input[name="importMode"]:checked').value;
            
            if (importMode === 'simple') {
                const selector = document.getElementById('listSelector');
                if (!selector || !selector.value) {
                    alert('❌ Please select a list first.');
                    return;
                }
            }
            
            // Create and trigger file input
            const input = document.createElement('input');
            input.type = 'file';
            input.accept = '.txt';
            input.onchange = async (e) => {
                const file = e.target.files[0];
                if (!file) return;
                
                try {
                    const text = await file.text();
                    
                    if (importMode === 'structured') {
                        await importStructuredTXT(text);
                    } else {
                        await importSimpleTXT(text);
                    }
                    
                } catch (error) {
                    alert('❌ Error importing TXT file: ' + error.message);
                }
            };
            
            input.click();
        }
        
        // Import structured TXT with sections, lists, and items
        async function importStructuredTXT(text) {
            const lines = text.split('\n').map(line => line.trim()).filter(line => line.length > 0);
            
            if (lines.length === 0) {
                alert('❌ The TXT file is empty or contains no valid content.');
                return;
            }
            
            let currentSection = null;
            let currentList = null;
            let addedSections = 0;
            let addedLists = 0;
            let addedItems = 0;
            
            for (const line of lines) {
                if (line.startsWith('# ')) {
                    // Section header
                    const sectionName = line.substring(2).trim();
                    
                    // Find existing section or create new one
                    currentSection = listSections.find(s => s.name === sectionName);
                    if (!currentSection) {
                        currentSection = {
                            id: Date.now().toString() + Math.random(),
                            name: sectionName,
                            lists: [],
                            collapsed: false,
                            createdAt: new Date().toISOString(),
                            order: listSections.length
                        };
                        listSections.push(currentSection);
                        addedSections++;
                    }
                    currentList = null; // Reset current list when entering new section
                    
                } else if (line.startsWith('## ')) {
                    // List header
                    const listName = line.substring(3).trim();
                    
                    if (!currentSection) {
                        // Create default section if none exists
                        currentSection = {
                            id: Date.now().toString() + Math.random(),
                            name: 'Imported',
                            lists: [],
                            collapsed: false,
                            createdAt: new Date().toISOString(),
                            order: listSections.length
                        };
                        listSections.push(currentSection);
                        addedSections++;
                    }
                    
                    // Find existing list in current section or create new one
                    currentList = currentSection.lists.find(l => l.name === listName);
                    if (!currentList) {
                        currentList = {
                            id: Date.now().toString() + Math.random(),
                            name: listName,
                            items: [],
                            createdAt: new Date().toISOString()
                        };
                        currentSection.lists.push(currentList);
                        addedLists++;
                    }
                    
                } else {
                    // Item line
                    if (!currentList) {
                        // Create default structure if none exists
                        if (!currentSection) {
                            currentSection = {
                                id: Date.now().toString() + Math.random(),
                                name: 'Imported',
                                lists: [],
                                collapsed: false,
                                createdAt: new Date().toISOString(),
                                order: listSections.length
                            };
                            listSections.push(currentSection);
                            addedSections++;
                        }
                        
                        currentList = {
                            id: Date.now().toString() + Math.random(),
                            name: 'Imported Items',
                            items: [],
                            createdAt: new Date().toISOString()
                        };
                        currentSection.lists.push(currentList);
                        addedLists++;
                    }
                    
                    // Initialize items array if it doesn't exist
                    if (!currentList.items) {
                        currentList.items = [];
                    }
                    
                    // Check if item already exists
                    const exists = currentList.items.some(item => item.text === line);
                    if (!exists) {
                        currentList.items.push({
                            id: Date.now() + Math.random(),
                            text: line,
                            completed: false
                        });
                        addedItems++;
                    }
                }
            }
            
            // Save and refresh
            await saveListSections();
            renderListsView();
            
            // Close modal
            document.getElementById('listSelectionModal').style.display = 'none';
            
            alert(`✅ Structured import complete!\nAdded ${addedSections} sections, ${addedLists} lists, and ${addedItems} items.`);
        }
        
        // Import simple TXT to selected list
        async function importSimpleTXT(text) {
            const selector = document.getElementById('listSelector');
            const [sectionId, listId] = selector.value.split('|');
            
            const lines = text.split('\n')
                .map(line => line.trim())
                .filter(line => line.length > 0);
            
            if (lines.length === 0) {
                alert('❌ The TXT file is empty or contains no valid items.');
                return;
            }
            
            // Find selected list
            const section = listSections.find(s => s.id === sectionId);
            if (!section) {
                alert('❌ Selected section not found.');
                return;
            }
            
            const list = section.lists.find(l => l.id === listId);
            if (!list) {
                alert('❌ Selected list not found.');
                return;
            }
            
            // Initialize items array if it doesn't exist
            if (!list.items) {
                list.items = [];
            }
            
            let addedCount = 0;
            lines.forEach(line => {
                // Check if item already exists
                const exists = list.items.some(item => item.text === line);
                if (!exists) {
                    list.items.push({
                        id: Date.now() + Math.random(),
                        text: line,
                        completed: false
                    });
                    addedCount++;
