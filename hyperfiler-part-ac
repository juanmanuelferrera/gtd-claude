        async function handleJsonImportFile(event) {
            const file = event.target.files[0];
            if (!file) return;
            
            // Ask user what they want to do with existing tasks
            const importChoice = confirm(`📥 IMPORT OPTIONS\n\nYou currently have ${tasks.length} tasks.\n\nClick OK to ADD imported tasks to existing ones\nClick Cancel to REPLACE all current tasks with imported ones\n\n✅ OK = Add to existing (safer)\n❌ Cancel = Replace all (deletes current)`);
            
            let replaceMode = false;
            if (!importChoice) {
                // User chose to replace - double check
                const replaceConfirm = confirm(`🚨 REPLACE MODE\n\nThis will DELETE your current ${tasks.length} tasks and replace them with the imported tasks.\n\nAre you sure you want to REPLACE everything?`);
                if (!replaceConfirm) {
                    return; // User cancelled
                }
                replaceMode = true;
            }
            
            // Show loading indicator
            showLoadingIndicator(replaceMode ? 'Replacing All Data...' : 'Adding Imported Data...');
            
            try {
                const fileName = file.name.toLowerCase();
                
                if (!fileName.endsWith('.json')) {
                    throw new Error('Please select a JSON file for complete data import.');
                }
                
                {
                    // Handle JSON import
                    updateProgress('Reading file...');
                    const text = await file.text();
                    const importData = JSON.parse(text);
                    
                    if (!importData.tasks || !Array.isArray(importData.tasks)) {
                        throw new Error('Invalid JSON file format');
                    }
                    
                    updateProgress(`Processing ${importData.tasks.length} tasks...`);
                    
                    // Clear existing tasks if in replace mode
                    if (replaceMode) {
                        tasks = [];
                        updateProgress('Cleared existing tasks...');
                    }
                    
                    // Optimized batch processing
                    let addedCount = 0;
                    const batchSize = 20;
                    
                    for (let i = 0; i < importData.tasks.length; i += batchSize) {
                        const batch = importData.tasks.slice(i, i + batchSize);
                        
                        for (const task of batch) {
                            const exists = replaceMode ? false : tasks.some(t => t.id === task.id);
                            if (!exists) {
                                // LEGACY FORMAT FIX: Handle old exports with [Due: ...] in title
                                if (task.title && task.title.includes('[Due:')) {
                                    const originalTitle = task.title;
                                    const dueDateMatch = originalTitle.match(/\[Due:\s*(\d{4}-\d{2}-\d{2})\]/);
                                    
                                    if (dueDateMatch) {
                                        // Extract date and clean title
                                        const extractedDate = dueDateMatch[1];
                                        task.title = originalTitle.replace(/\s*\[Due:\s*\d{4}-\d{2}-\d{2}\]/, '').trim();
                                        
                                        // Set dueDate if not already set
                                        if (!task.dueDate) {
                                            task.dueDate = extractedDate;
                                        }
                                        
                                        console.log(`🔧 IMPORT FIX: Extracted date from legacy format: "${originalTitle}" → "${task.title}" (dueDate: ${task.dueDate})`);
                                    }
                                }
                                
                                // Validate title before processing
                                const validatedTitle = validateTaskTitle(task.title);
                                if (!validatedTitle) {
                                    console.warn('Skipping task with invalid title:', task.title);
                                    continue;
                                }
                                
                                // Apply validation
                                task.title = validatedTitle;
                                task.notes = validateTaskNotes(task.notes);
                                
                                // Clean and validate task data before adding
                                const cleanedTask = cleanTaskForStorage(task);
                                cleanedTask.updatedAt = new Date().toISOString();
                                tasks.push(cleanedTask);
                                addedCount++;
                            }
                        }
                        
                        // Update progress
                        updateProgress(`Processing tasks: ${Math.min(i + batchSize, importData.tasks.length)} / ${importData.tasks.length}`);
                        
                        // Allow UI to update
                        await new Promise(resolve => setTimeout(resolve, 10));
                    }
                    
                    // Save all tasks at once (much faster)
                    if (addedCount > 0) {
                        updateProgress('Saving to server...');
                        await saveTasksToServer();
                    }
                    
                    // Import list sections if they exist
                    let addedListSections = 0;
                    if (importData.listSections && Array.isArray(importData.listSections)) {
                        updateProgress('Processing list sections...');
                        for (const section of importData.listSections) {
                            const exists = listSections.some(s => s.id === section.id);
                            if (!exists) {
                                listSections.push(section);
                                addedListSections++;
                            }
                        }
                        if (addedListSections > 0) {
                            await saveListSections();
                            renderListsView();
                        }
                    }
                    
                    // Import templates if they exist
                    let addedTemplates = 0;
                    if (importData.templates && Array.isArray(importData.templates)) {
                        updateProgress('Processing templates...');
                        for (const template of importData.templates) {
                            if (!customTemplates.includes(template)) {
                                customTemplates.push(template);
                                addedTemplates++;
                            }
                        }
                        if (addedTemplates > 0) {
                            await saveTemplates();
                            renderTemplateButtons();
                            populateTemplateFilter();
                        }
                    }
                    
                    // Import trash if it exists
                    let addedTrashItems = 0;
                    if (importData.trash && Array.isArray(importData.trash)) {
                        updateProgress('Processing trash items...');
                        for (const trashItem of importData.trash) {
                            const exists = trash.some(t => t.trashId === trashItem.trashId);
                            if (!exists) {
                                trash.push(trashItem);
                                addedTrashItems++;
                            }
                        }
                        if (addedTrashItems > 0) {
                            localStorage.setItem('gtd_trash', JSON.stringify(trash));
                            updateTrashCounter();
                        }
                    }
                    
                    updateProgress('Finalizing import...');
                    sortTasks();
                    renderCurrentView();
                    
                    // Remove loading indicator
                    hideLoadingIndicator();
                    
                    const listMessage = addedListSections > 0 ? ` and ${addedListSections} list sections` : '';
                    const templateMessage = addedTemplates > 0 ? ` and ${addedTemplates} templates` : '';
                    const trashMessage = addedTrashItems > 0 ? ` and ${addedTrashItems} trash items` : '';
                    
                    if (replaceMode) {
                        alert(`✅ Data backup import complete! Replaced all data with ${addedCount} tasks${listMessage}${templateMessage}${trashMessage}.`);
                    } else {
                        alert(`✅ Data backup import complete! Added ${addedCount} new tasks${listMessage}${templateMessage}${trashMessage} to your existing data.`);
                    }
                }
                
            } catch (error) {
                console.error('Import error:', error);
                hideLoadingIndicator();
                alert('❌ Error importing: ' + error.message);
            }
            
            event.target.value = '';
        }

        async function handleTextImportFile(event) {
            const file = event.target.files[0];
            if (!file) return;
            
            // For text files, we always add to today (no replace/add choice)
            const addToExisting = confirm(`📝 PLAIN TEXT IMPORT\n\nYou currently have ${tasks.length} tasks.\n\nThis will add the imported tasks to TODAY without any time.\n\n✅ OK = Add tasks to today\n❌ Cancel = Cancel import\n\nProceed with import?`);
            
            if (!addToExisting) {
                return; // User cancelled
            }
            
            // Show loading indicator
            showLoadingIndicator('Importing Text File...');
            
            try {
                // Handle text file import - one task per line (.txt, .org, or any text file)
                updateProgress('Reading text file...');
                const text = await file.text();
                const lines = text.split('\n')
                    .map(line => line.trim())
                    .filter(line => line.length > 0); // Remove empty lines
                
                if (lines.length === 0) {
                    throw new Error('Text file is empty or contains no valid tasks');
                }
                
                updateProgress(`Processing ${lines.length} tasks...`);
                
                // Get today's date for new tasks
                const today = new Date();
                const todayStr = getLocalDateString(today);
                
                // Process each line as a task
                let addedCount = 0;
                const batchSize = 50;
                
                for (let i = 0; i < lines.length; i += batchSize) {
                    const batch = lines.slice(i, i + batchSize);
                    
                    for (const line of batch) {
                        // Validate task title
                        const validatedTitle = validateTaskTitle(line);
                        if (!validatedTitle) {
                            console.warn('Skipping invalid task line:', line);
                            continue;
                        }
                        
                        // Create new task for today without time
                        const newTask = {
                            id: Date.now() + '_' + Math.random().toString(36).substr(2, 9),
                            title: validatedTitle,
                            dueDate: todayStr,
                            dueTime: null, // No time assigned
                            notes: '',
                            images: [],
                            status: 'pending',
                            priority: 'medium',
                            tags: [],
                            createdAt: new Date().toISOString(),
                            updatedAt: new Date().toISOString(),
                            lastModified: new Date().toISOString()
                        };
                        
                        // Clean and add task
                        const cleanedTask = cleanTaskForStorage(newTask);
                        tasks.push(cleanedTask);
                        addedCount++;
                    }
                    
                    // Update progress
                    updateProgress(`Processing tasks: ${Math.min(i + batchSize, lines.length)} / ${lines.length}`);
                    
                    // Allow UI to update
                    await new Promise(resolve => setTimeout(resolve, 5));
                }
                
                // Save tasks to server
                if (addedCount > 0) {
                    updateProgress('Saving to server...');
                    await saveTasksToServer();
                }
                
                updateProgress('Finalizing import...');
                sortTasks();
                renderCurrentView();
                
                // Remove loading indicator
                hideLoadingIndicator();
                
                alert(`✅ Plain text import complete! Added ${addedCount} new tasks to today's schedule.`);
                
            } catch (error) {
                console.error('Text import error:', error);
                hideLoadingIndicator();
                alert('❌ Error importing text file: ' + error.message);
            }
            
            event.target.value = '';
        }

        // Move incomplete tasks from previous days to today (except Events)
        async function moveIncompleteTasks() {
            console.log('⏭️ moveIncompleteTasks - checking for tasks to move to today');
            
            let movedCount = 0;
            const today = new Date();
            const todayStr = getLocalDateString(today); // Use the same date function as everywhere else
            
            console.log('📅 Debug - Today date string:', todayStr);
            console.log('📅 Debug - Total tasks:', tasks.length);
            
            try {
                // Find incomplete tasks from previous days (not deleted, not events)
                const tasksToMove = [];
                
                for (let i = 0; i < tasks.length; i++) {
                    const task = tasks[i];
                    if (task.isDeleted || task.isEvent || task.status === 'completed') {
                        continue;
                    }
                    
                    if (task.dueDate) {
                        console.log('📅 Debug - Checking task:', task.title, 'Due:', task.dueDate, 'Status:', task.status);
                        // Simple string comparison for YYYY-MM-DD format
                        if (task.dueDate < todayStr) {
                            tasksToMove.push({task: task, index: i});
                        }
                    }
                }
                
                console.log(`📅 Found ${tasksToMove.length} incomplete tasks from previous days`);
                
                if (tasksToMove.length > 0) {
                    // Set flag to prevent downloads from overwriting moved tasks
                    window.justMovedTasks = true;
                    
                    // Move tasks to today's date using direct array index updates
                    for (const {task, index} of tasksToMove) {
                        console.log(`📅 STARTING to move task "${task.title}" from ${task.dueDate} to ${todayStr} (keeping time: ${task.dueTime || 'none'})`);
                        console.log(`📅 Task before move:`, {
                            id: task.id,
                            title: task.title,
                            dueDate: task.dueDate,
                            originalDueDate: task.originalDueDate,
                            isOverdue: task.isOverdue,
                            status: task.status
                        });
                        
                        try {
                            // PRESERVE ORIGINAL DATE: Save original due date before moving
                            if (!tasks[index].originalDueDate) {
                                tasks[index].originalDueDate = task.dueDate;
                                console.log(`💾 Preserving original date: ${task.dueDate} for task "${task.title}"`);
                            }
                            
                            // Mark as overdue task
                            tasks[index].isOverdue = true;
                            
                            // Update the task in the tasks array directly using the index
                            tasks[index].dueDate = todayStr;
                            tasks[index].updatedAt = new Date().toISOString();
                            // Keep the original dueTime - don't change it
                            
                            console.log(`✅ MOVED task ${task.title} - new dueDate: ${tasks[index].dueDate}, originalDueDate: ${tasks[index].originalDueDate}, dueTime: ${tasks[index].dueTime}`);
                            console.log(`📅 Task after move:`, {
                                id: tasks[index].id,
                                title: tasks[index].title,
                                dueDate: tasks[index].dueDate,
                                originalDueDate: tasks[index].originalDueDate,
                                isOverdue: tasks[index].isOverdue,
                                status: tasks[index].status
                            });
                            
                            movedCount++;
                        } catch (moveError) {
                            console.error(`❌ Error moving task ${task.title}:`, moveError);
                        }
                    }
                    
                    // Save to localStorage
                    saveTasksToLocalStorage();
                    
                    // Sync to cloud
                    await uploadAllTasks();
                    
                    // Clear flag after successful upload
                    setTimeout(() => {
                        window.justMovedTasks = false;
                        console.log('🔓 Cleared justMovedTasks flag');
                    }, 5000); // 5 seconds for reliable cross-browser sync
                    
                    console.log(`✅ Successfully moved ${movedCount} tasks to today`);
                    
                    // Debug: Check what tasks are now scheduled for today
                    const todayTasksAfterMove = tasks.filter(task => 
                        task.dueDate === todayStr && !task.isDeleted && task.status !== 'completed'
                    );
                    console.log(`📅 Debug: After move, ${todayTasksAfterMove.length} tasks scheduled for today:`, 
                        todayTasksAfterMove.map(t => `${t.title} (time: ${t.dueTime || 'none'})`)
                    );
                } else {
                    console.log('📅 No tasks to move');
                }
                
                return movedCount;
                
            } catch (error) {
                console.error('❌ Error moving incomplete tasks:', error);
                return 0;
            }
        }

