        // Convert selected items to tasks
        async function convertSelectedItemsToTasks() {
            const section = listSections.find(s => s.id == currentListSectionId);
            if (!section) return;
            
            const list = section.lists.find(l => l.id == currentListId);
            if (!list || !list.items) return;
            
            const selectedIndices = [];
            
            list.items.forEach((item, index) => {
                if (item.completed) {
                    selectedIndices.push(index);
                }
            });
            
            if (selectedIndices.length === 0) {
                alert('No completed items selected for conversion.');
                return;
            }
            
            const today = new Date();
            const todayString = today.toISOString().split('T')[0];
            
            try {
                let convertedCount = 0;
                
                for (const index of selectedIndices) {
                    const item = list.items[index];
                    if (!item) continue;
                    
                    const taskId = Math.floor(Date.now() + Math.random() * 1000 + convertedCount);
                    
                    // Create task object
                    const newTask = {
                        id: taskId,
                        title: item.text,
                        notes: '',
                        images: [],
                        dueDate: todayString,
                        dueTime: null,
                        status: 'pending',
                        isEvent: false,
                        repeat: null,
                        createdAt: new Date().toISOString()
                    };
                    
                    // Add to tasks array and save
                    tasks.push(newTask);
                    await saveTask(newTask);
                    convertedCount++;
                }
                
                // Clear completed status after conversion
                selectedIndices.forEach(index => {
                    if (list.items[index]) {
                        list.items[index].completed = false;
                    }
                });
                await saveListSections();
                updateConvertButtons();
                
                // Refresh views
                renderListItems();
                renderListsView();
                
                // Refresh current view if it shows tasks
                if (currentView === 'today') {
                    renderTodayView();
                } else if (currentView === 'week') {
                    renderWeekView();
                } else if (currentView === 'calendar') {
                    renderCalendarView();
                } else if (currentView === 'all') {
                    performAllTasksSearch();
                }
                
                alert(`✅ Converted ${convertedCount} completed items to tasks for today!`);
                
            } catch (error) {
                console.error('Error converting selected items to tasks:', error);
                alert('❌ Error converting items to tasks: ' + error.message);
            }
        }
        
