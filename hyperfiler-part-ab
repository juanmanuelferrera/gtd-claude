        // Go to task function - navigates to the appropriate view and highlights the task
        function goToTask(taskId) {
            const task = tasks.find(t => t.id == taskId);
            if (!task) {
                alert('Task not found');
                return;
            }

            // Determine which view to switch to based on task date
            const today = getLocalDateString();
            const taskDate = task.dueDate;
            
            if (!taskDate) {
                // No date - go to search view
                showView('tasks');
                setTimeout(() => {
                    const searchInput = document.getElementById('searchInput');
                    if (searchInput) {
                        searchInput.value = task.title;
                        searchTasks();
                    }
                }, 100);
            } else if (taskDate === today) {
                // Today's task
                showView('today');
            } else {
                // Get week range for this week
                const now = new Date();
                const startOfWeek = getStartOfWeek(now);
                const endOfWeek = new Date(startOfWeek);
                endOfWeek.setDate(startOfWeek.getDate() + 6);
                
                const taskDateObj = new Date(taskDate);
                
                if (taskDateObj >= startOfWeek && taskDateObj <= endOfWeek) {
                    // This week's task
                    showView('week');
                } else {
                    // Other date - go to calendar view
                    showView('calendar');
                }
            }

            // Highlight the task after switching views
            setTimeout(() => {
                const taskElement = document.querySelector(`[data-task-id="${taskId}"]`);
                if (taskElement) {
                    taskElement.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    taskElement.style.background = '#fff3cd';
                    taskElement.style.border = '2px solid #ffc107';
                    setTimeout(() => {
                        taskElement.style.background = '';
                        taskElement.style.border = '';
                    }, 3000);
                }
            }, 300);
        }

