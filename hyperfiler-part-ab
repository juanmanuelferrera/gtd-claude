                    return null;
                }
                
                // Apply validation to task data
                taskData.title = validatedTitle;
                taskData.notes = validatedNotes;
                
                // Clean the task data to remove circular references
                const cleanedTask = cleanTaskForStorage(taskData);
                
                // Add/update timestamp for safety checks and conflict resolution
                cleanedTask.updatedAt = new Date().toISOString();
                cleanedTask.lastModified = new Date().toISOString();
                
                // 1. UPDATE ARRAY IMMEDIATELY
                const existingIndex = tasks.findIndex(t => t.id === taskData.id);
                const isNewTask = existingIndex < 0;
                if (existingIndex >= 0) {
                    // 🔄 TRIPLE-LAYER PROTECTION: Track version before update
                    if (window.TripleProtection) {
                        await window.TripleProtection.versions.track(taskData.id, tasks[existingIndex], 'pre-edit', 'State before update');
                    }
                    
                    tasks[existingIndex] = cleanedTask;
                    
                    // 🔄 TRIPLE-LAYER PROTECTION: Track version after update
                    if (window.TripleProtection) {
                        await window.TripleProtection.versions.track(taskData.id, cleanedTask, 'edit', 'Task updated');
                    }
                    
                    // 📊 DELTA SYNC: Track update for efficient sync
                    trackTaskUpdated(cleanedTask);
                    
                    // Task updated successfully
                } else {
                    tasks.push(cleanedTask);
                    
                    // 🔄 TRIPLE-LAYER PROTECTION: Track version for new task
                    if (window.TripleProtection) {
                        await window.TripleProtection.versions.track(taskData.id, cleanedTask, 'create', 'New task created');
