        // Add premium analytics
        function addPremiumAnalytics() {
            
            // Add productivity score calculation
            window.calculateProductivityScore = function() {
                const today = new Date();
                const sevenDaysAgo = new Date(today.getTime() - 7 * 24 * 60 * 60 * 1000);
                
                const recentTasks = tasks.filter(task => {
                    const taskDate = new Date(task.created_at || task.createdAt);
                    return taskDate >= sevenDaysAgo;
                });
                
                const completedTasks = recentTasks.filter(task => task.status === 'completed');
                const score = recentTasks.length > 0 ? Math.round((completedTasks.length / recentTasks.length) * 100) : 0;
                
                return {
                    score: score,
                    completed: completedTasks.length,
                    total: recentTasks.length,
                    period: '7 days'
                };
            };
        }

